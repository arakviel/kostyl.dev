<style>
.avu, .avd { position: absolute; width: 8px; background: currentColor; opacity: 0; }
.avu::after { content: ""; position: absolute; left: -14px; top: -24px; border-bottom: 28px solid currentColor; border-left: 18px solid transparent; border-right: 18px solid transparent; }
.avd::after { content: ""; position: absolute; left: -14px; bottom: -24px; border-top: 28px solid currentColor; border-left: 18px solid transparent; border-right: 18px solid transparent; }
.hid { opacity: 0; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="code" class="card" style="left:360px;top:80px;width:1200px;height:120px;background:#1e1e1e;border-color:#3a3a3a">
    <div class="mono abs" style="left:0;width:1200px;text-align:center;top:22px;font-size:62px;white-space:nowrap"><span id="nm" style="color:#dcdcaa">print</span><span id="pp" style="color:#ffd700">(</span><span style="color:#ce9178">"Hello"</span><span id="pq" style="color:#ffd700">)</span></div>
  </div>
  <div id="lcall" class="lab hid" style="left:0;width:1920px;text-align:center;top:215px;color:#fbbf24;font-size:38px">виклик: дужки запускають функцію</div>
  <div id="names" class="card hid" style="left:160px;top:300px;width:520px;height:260px">
    <div class="lab" style="left:28px;top:18px">імена</div>
    <div class="mono abs" style="left:40px;top:100px;width:200px;height:90px;border:4px solid #22d3ee;border-radius:14px;color:#22d3ee;font-size:50px;display:flex;align-items:center;justify-content:center">print</div>
  </div>
  <div id="arN" class="ar r" style="left:450px;top:445px;width:540px;color:#22d3ee"></div>
  <div id="plq" class="card hid" style="left:1000px;top:300px;width:700px;height:300px;border-color:#34d399">
    <div class="mono abs" style="left:24px;top:22px;font-size:30px;color:#9fb2cf">builtin_function_or_method</div>
    <div class="mono abs" style="left:0;width:700px;top:110px;text-align:center;font-size:80px;color:#34d399">print</div>
    <div class="lab" style="left:24px;top:230px;font-size:30px">об'єкт-функція</div>
  </div>
  <div id="arg" class="card hid" style="left:1000px;top:700px;width:300px;height:110px;border-color:#34d399"><div class="mono abs" style="left:0;width:300px;top:28px;text-align:center;font-size:50px;color:#ce9178">'Hello'</div></div>
  <div id="avA" class="avu" style="left:1146px;top:620px;height:70px;color:#34d399"></div>
  <div id="term" class="vsw hid" style="left:160px;top:640px;width:700px;height:200px">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="th1" class="vsx" style="top:78px;color:#34d399;font-weight:700;font-size:44px">Hello</div>
  </div>
  <div id="none" class="card hid" style="left:1400px;top:700px;width:300px;height:110px;border-color:#9fb2cf"><div class="mono abs" style="left:0;width:300px;top:26px;text-align:center;font-size:54px;color:#9fb2cf">None</div></div>
  <div id="avB" class="avd" style="left:1546px;top:612px;height:58px;color:#9fb2cf"></div>
  <div id="lret" class="lab hid" style="left:1380px;top:830px;font-size:32px">значення виклику</div>
  <div id="cap" class="mono abs hid" style="left:0;width:1920px;text-align:center;top:930px;font-size:44px;color:#e8eef7"><span style="color:#9cdcfe">x</span> = <span style="color:#dcdcaa">print</span>(<span style="color:#ce9178">"Hi"</span>)  →  <span style="color:#9cdcfe">x</span> це <span style="color:#9fb2cf">None</span></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
// L1 name -> function object
tl.to("#nm", { backgroundColor: "rgba(34,211,238,0.3)", duration: 0.3 }, T[0] + 0.6);
show("#names", T[0] + 1.2); show("#arN", T[0] + 2.2); show("#plq", T[0] + 2.4);
// L2 parentheses call it, argument goes in
tl.to("#nm", { backgroundColor: "rgba(34,211,238,0)", duration: 0.2 }, T[1] + 0.3);
tl.to(["#pp", "#pq"], { backgroundColor: "rgba(251,191,36,0.35)", duration: 0.3 }, T[1] + 0.5);
show("#lcall", T[1] + 0.6); show("#arg", T[1] + 2.0); show("#avA", T[1] + 2.5);
// L3 runs and prints
pulse("#plq", T[2] + 0.3, 1.04); show("#term", T[2] + 0.8); show("#th1", T[2] + 1.3, 0.1); pulse("#th1", T[2] + 1.3, 1.08);
// L4 returns None
hide("#lcall", T[3] + 0.2, 0.3);
show("#avB", T[3] + 0.8); show("#none", T[3] + 1.0); show("#lret", T[3] + 1.6); pulse("#none", T[3] + 1.2, 1.08);
show("#cap", T[3] + 2.8);
hide("#code", CL - 0.35, 0.3); hide("#lcall", CL - 0.35, 0.1);
window.__timelines["world"] = tl;
</script>
