<style>
.pg7 { position: absolute; left: 24px; top: 70px; width: 1700px; height: 560px; opacity: 0; }
.tl7 { position: absolute; left: 0; height: 46px; display: flex; align-items: center; font-family: "JetBrains Mono", monospace; font-weight: 500; font-size: 32px; color: #cccccc; white-space: pre; opacity: 0; }
.tl7 .ty { display: inline-block; overflow: hidden; white-space: pre; width: 0; }
.sq { position: absolute; height: 0; border-bottom: 5px dotted #f14c4c; opacity: 0; }
.an { position: absolute; font-size: 34px; font-weight: 700; opacity: 0; white-space: nowrap; }
.tabx { position: absolute; top: 48px; height: 56px; padding: 0 28px; display: flex; align-items: center; font-family: "JetBrains Mono", monospace; font-weight: 500; font-size: 28px; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
 <div id="win" class="vsw" style="left:40px;top:40px;width:1840px;height:1000px">
  <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">lesson-01</div></div>
  <div class="vsr"></div>
  <div id="tab1" class="tabx" style="left:0;background:#1e1e1e;color:#fff;border-top:3px solid #3794ff">e1.py</div>
  <div id="tab2" class="tabx" style="left:130px;background:#2d2d2d;color:#8c8c8c">e2.py</div>
  <div id="cd1"><div class="vsl" style="top:118px;font-size:44px"><span class="n">1</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span><span style="color:#ffd700">(</span><span style="color:#ce9178">"Hello)</span></span></span></div></div>
  <div id="cd2" style="opacity:0"><div class="vsl" style="top:118px;font-size:44px"><span class="n">1</span><span style="white-space:pre"><span style="color:#dcdcaa">prnt</span><span style="color:#ffd700">(</span><span style="color:#ce9178">"Hello"</span><span style="color:#ffd700">)</span></span></div></div>
  <div id="sq1" class="sq" style="left:250px;top:165px;width:185px"></div>
  <div id="sq2" class="sq" style="left:92px;top:165px;width:106px"></div>
  <div class="vsterm" style="top:230px;height:770px;bottom:auto">
    <div class="vsth">ТЕРМІНАЛ</div>
    <div id="p1" class="pg7"></div><div id="p2" class="pg7"></div>
    <div id="an1" class="an" style="left:1290px;top:330px;color:#fbbf24">← тип помилки і причина</div>
    <div id="an2" class="an" style="left:820px;top:176px;color:#22d3ee">← де: файл і рядок</div>
    <div id="hl" style="position:absolute;left:12px;top:0;width:1250px;height:46px;background:rgba(241,76,76,0.18);opacity:0"></div>
  </div>
 </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const R = "#f14c4c", A = "#fbbf24", G = "#9fb2cf";
const PR = '<span style="color:#4ec9b0">lesson-01 %&nbsp;</span>';
const pages = {
  p1: [["cmd", "python3 e1.py"], ['  File "e1.py", line 1', G], ['    print("Hello)', "#cccccc"], ["          ^", R], ["SyntaxError: unterminated string literal (detected at line 1)", R, true]],
  p2: [["cmd", "python3 e2.py"], ["Traceback (most recent call last):", G], ['  File "e2.py", line 1, in <module>', G], ['    prnt("Hello")', "#cccccc"], ["    ^^^^", R], ["NameError: name 'prnt' is not defined. Did you mean: 'print'?", R, true]],
};
for (const [p, ls] of Object.entries(pages)) ls.forEach((l, i) => {
  const top = i * 52;
  if (l[0] === "cmd") $(p).insertAdjacentHTML("beforeend", `<div id="${p}l${i}" class="tl7" style="top:${top}px">${PR}<span id="${p}t${i}" class="ty">${l[1]}</span></div>`);
  else $(p).insertAdjacentHTML("beforeend", `<div id="${p}l${i}" class="tl7" style="top:${top}px;color:${l[1]};${l[2] ? "font-weight:700;" : ""}">${l[0].replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/ /g, "&nbsp;")}</div>`);
});
tl.set("#p1", { opacity: 1 }, 0);
// L1 first error: unclosed string
show("#sq1", T[0] + 2.0, 0.3);
// L2 SyntaxError
show("#p1l0", T[1] + 0.3, 0.05); typeIn("#p1t0", 13, T[1] + 0.4, 0.7);
show("#p1l1", T[1] + 1.8, 0.1); show("#p1l2", T[1] + 2.4, 0.1); show("#p1l3", T[1] + 3.0, 0.1);
show("#p1l4", T[1] + 3.6, 0.1); pulse("#p1l4", T[1] + 3.7, 1.02);
// L3 NameError
hide("#p1", T[2] - 0.1, 0.2); hide("#cd1", T[2] - 0.1, 0.2); hide("#sq1", T[2] - 0.1, 0.1);
tl.set("#tab1", { backgroundColor: "#2d2d2d", color: "#8c8c8c", borderTop: "0px solid #3794ff" }, T[2] - 0.05);
tl.set("#tab2", { backgroundColor: "#1e1e1e", color: "#ffffff", borderTop: "3px solid #3794ff" }, T[2] - 0.05);
show("#cd2", T[2] + 0.1, 0.1); show("#sq2", T[2] + 0.4, 0.3); tl.set("#p2", { opacity: 1 }, T[2] + 0.2);
show("#p2l0", T[2] + 0.6, 0.05); typeIn("#p2t0", 13, T[2] + 0.7, 0.7);
[1, 2, 3, 4].forEach((k, j) => show("#p2l" + k, T[2] + 1.6 + j * 0.55, 0.1));
show("#p2l5", T[2] + 3.9, 0.1); pulse("#p2l5", T[2] + 4.0, 1.02);
// L4 how to read it
tl.set("#hl", { top: 5 * 52 + 72 }, T[3] + 0.2); show("#hl", T[3] + 0.3, 0.2); show("#an1", T[3] + 0.4);
show("#an2", T[3] + 2.8);
hide("#win", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
