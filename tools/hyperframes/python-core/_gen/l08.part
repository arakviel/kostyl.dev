<script>
/*PRE*/
/*HW*/
/*T*/
tl.set(["#c1", "#c2", "#c3", "#c4"], { opacity: 1 }, 0);
pulse("#c1", 1.0, 1.04); pulse("#c2", 1.6, 1.04); pulse("#c3", 2.2, 1.04); pulse("#c4", 2.8, 1.04);
// L2 print call
show("#c1a", T[1] + 0.8); show("#c1b", T[1] + 2.6); pulse("#c1", T[1] + 2.7, 1.03); pulse("#c1a", T[1] + 3.4, 1.06); pulse("#c1b", T[1] + 4.2, 1.1); pulse("#c1", T[1] + 5.0, 1.03);
// L3 arguments
show("#c2a", T[2] + 0.8); show("#c2b", T[2] + 3.0); pulse("#c2", T[2] + 3.1, 1.03);
// L4 stdout
show("#c3a", T[3] + 0.8); show("#c3b", T[3] + 3.0); pulse("#c3", T[3] + 3.1, 1.03);
// L5 errors
show("#c4a", T[4] + 0.6); show("#c4b", T[4] + 1.8); show("#c4c", T[4] + 2.6); pulse("#c4", T[4] + 2.8, 1.03);
window.__timelines["world"] = tl;
