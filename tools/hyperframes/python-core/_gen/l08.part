    <div id="c2b" class="cb mono" style="left:0;width:820px;top:220px;text-align:center;font-size:60px;color:#34d399">a-b</div></div>
  <div id="c3" class="cd8" style="left:100px;top:620px;border-color:#34d399"><div class="ct" style="color:#34d399">stdout — потік символів</div>
    <div id="c3a" class="cb" style="left:0;top:0;width:820px;height:330px"><div class="k8" style="left:230px;color:#34d399">H</div><div class="k8" style="left:360px;color:#34d399">i</div><div class="k8" style="left:490px;color:#fb7185;border-color:#fb7185">↵</div></div>
    <div id="c3b" class="cb lab" style="left:0;width:820px;text-align:center;top:270px;color:#fb7185;font-size:34px">↵ — один символ</div></div>
  <div id="c4" class="cd8" style="left:1000px;top:620px;border-color:#fb7185"><div class="ct" style="color:#fb7185">Помилка: читай з кінця</div>
