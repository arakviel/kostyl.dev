    <div id="c1a" class="cb mono" style="left:0;width:820px;top:120px;text-align:center;font-size:56px;white-space:nowrap"><span style="color:#dcdcaa">print</span><span style="color:#ffd700">(</span><span style="color:#ce9178">"Hi"</span><span style="color:#ffd700">)</span></div>
