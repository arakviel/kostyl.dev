<style>
.cell { position: absolute; top: 290px; width: 240px; height: 200px; border-radius: 16px; background: #0e1626; border: 3px solid #26365a; }
.cell.on { border-color: #22d3ee; }
.num { position: absolute; top: 290px; width: 240px; height: 200px; display: flex; align-items: center; justify-content: center; font-size: 88px; color: #34d399; opacity: 0; }
.adr { position: absolute; top: 505px; width: 240px; text-align: center; font-size: 40px; color: #9fb2cf; opacity: 0; }
.chr { position: absolute; top: 150px; width: 240px; text-align: center; font-size: 110px; color: #22d3ee; opacity: 0; }
.lbl { position: absolute; font-size: 34px; font-weight: 700; white-space: nowrap; opacity: 0; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <!-- scene A: strip of cells + editor -->
  <div id="scA">
    <div class="lab" style="left:60px;top:60px;font-size:40px;opacity:0" id="hd">оперативна пам'ять</div>
    <div id="cells"></div><div id="nums"></div><div id="adrs"></div><div id="chrs"></div>
    <div id="ed" class="vsw" style="left:510px;top:600px;width:900px;height:440px;opacity:0">
      <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">numbers.py</div></div>
      <div class="vsr"></div><div class="vst">numbers.py</div>
      <div class="vsl" style="top:118px"><span class="n">1</span><span id="e1" class="ty"><span style="color:#dcdcaa">print</span><span style="color:#ffd700">(</span><span style="color:#dcdcaa">ord</span><span style="color:#da70d6">(</span><span style="color:#ce9178">"H"</span><span style="color:#da70d6">)</span><span style="color:#ffd700">)</span></span></div>
      <div class="vsl" style="top:172px"><span class="n">2</span><span id="e2" class="ty"><span style="color:#dcdcaa">print</span><span style="color:#ffd700">(</span><span style="color:#dcdcaa">chr</span><span style="color:#da70d6">(</span><span style="color:#b5cea8">101</span><span style="color:#da70d6">)</span><span style="color:#ffd700">)</span></span></div>
      <div class="vsterm" style="height:196px"><div class="vsth">ТЕРМІНАЛ</div>
        <div id="t0" class="vsx" style="top:52px"><span style="color:#4ec9b0">lesson-00 %&nbsp;</span><span id="t0y" class="ty">python3 numbers.py</span></div>
        <div id="t1" class="vsx" style="top:98px">72</div>
        <div id="t2" class="vsx" style="top:144px">e</div></div>
    </div>
  </div>
  <!-- scene B1: motherboard -->
  <div id="board" style="position:absolute;left:260px;top:150px;width:1400px;height:780px;opacity:0">
    <svg id="bsvg" width="1400" height="780" viewBox="0 0 1400 780" xmlns="http://www.w3.org/2000/svg"></svg>
    <div id="slotHi" style="position:absolute;left:716px;top:106px;width:64px;height:568px;border:5px solid #22d3ee;border-radius:10px;opacity:0"></div>
    <div id="bl1" class="lbl" style="left:150px;top:540px;color:#e8eef7;font-size:40px;text-shadow:0 2px 8px #000">процесор</div>
    <div id="bl2" class="lbl" style="left:560px;top:30px;color:#22d3ee;font-size:40px;text-shadow:0 2px 8px #000">модулі оперативної пам'яті</div>
  </div>
  <!-- scene B2: DIMM close-up -->
  <div id="scB" style="position:absolute;inset:0;opacity:0">
    <div id="dlab" class="lbl" style="left:0;width:1920px;text-align:center;top:190px;font-size:44px;color:#e8eef7">модуль оперативної пам'яті (DIMM)</div>
    <div id="dimm" style="position:absolute;left:210px;top:290px;width:1500px"></div>
    <div id="clab" class="lbl" style="left:0;width:1920px;text-align:center;top:630px;font-size:36px;color:#22d3ee">чип пам'яті: комірки з адресами</div>
    <div id="wire" style="position:absolute;left:878px;top:488px;width:4px;height:150px;background:#22d3ee;opacity:0"></div>
    <div id="panel" class="card" style="left:360px;top:690px;width:1200px;height:300px;opacity:0;border-color:#22d3ee">
      <div id="pc"></div>
    </div>
    <div id="cap" class="lbl" style="left:0;width:1920px;text-align:center;top:110px;font-size:46px;color:#fbbf24">наші п'ять байтів — крихітна частина масиву</div>
  </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
// ---- scene A
const $ = (id) => document.getElementById(id);
const X0 = 60, W = 240, G = 20;
const vals = [null, 72, 101, 108, 108, 111, null], chars = [null, "H", "e", "l", "l", "o", null];
for (let i = 0; i < 7; i++) {
  const x = X0 + i * (W + G);
  $("cells").insertAdjacentHTML("beforeend", `<div class="cell${vals[i] ? " on" : ""}" style="left:${x}px"></div>`);
  $("adrs").insertAdjacentHTML("beforeend", `<div id="ad${i}" class="adr mono" style="left:${x}px">${999 + i}</div>`);
  if (vals[i]) {
    $("nums").insertAdjacentHTML("beforeend", `<div id="nm${i}" class="num mono" style="left:${x}px">${vals[i]}</div>`);
    $("chrs").insertAdjacentHTML("beforeend", `<div id="ch${i}" class="chr mono" style="left:${x}px">${chars[i]}</div>`);
  }
}
tl.set("#hd", { opacity: 1 }, 0);
for (let i = 0; i < 7; i++) pulse(".cell:nth-child(" + (i + 1) + ")", 0.9 + i * 0.3, 1.04);
for (let i = 0; i < 7; i++) show("#ad" + i, T[1] + 0.2 + i * 0.12, 0.25);
pulse("#ad1", T[1] + 1.1, 1.15);
for (let i = 1; i <= 5; i++) show("#ch" + i, T[2] + 0.3 + (i - 1) * 0.4, 0.25);
const at = [2.1, 2.75, 3.3, 3.9, 4.5];
for (let i = 1; i <= 5; i++) { show("#nm" + i, T[3] + at[i - 1], 0.25); pulse("#nm" + i, T[3] + at[i - 1], 1.15); }
// editor: numbers.py
show("#ed", T[4] + 0.1, 0.3);
typeIn("#e1", 15, T[4] + 0.6, 0.7); typeIn("#e2", 15, T[4] + 1.4, 0.7);
show("#t0", T[4] + 2.0, 0.05); typeIn("#t0y", 18, T[4] + 2.1, 0.7);
show("#t1", T[4] + 2.9, 0.05); show("#t2", T[4] + 3.2, 0.05);
for (let i = 1; i <= 5; i++) tl.to("#ch" + i, { color: "#fbbf24", duration: 0.3 }, T[4] + 1.0 + i * 0.1);
// ---- board svg
const B = [];
B.push(`<defs><linearGradient id="sgB" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e3e9f3"/><stop offset="1" stop-color="#8794ab"/></linearGradient></defs>`);
B.push(`<rect x="3" y="3" width="1394" height="774" rx="20" fill="#123d2f" stroke="#1f6b52" stroke-width="6"/>`);
[["M40 130 H110 V200","M40 520 H120"],["M420 260 H600","M420 340 H600","M420 420 H600"],["M1120 120 H1300 V400","M1120 600 H1300"]].flat().forEach((d) => B.push(`<path d="${d}" stroke="#1b5a45" stroke-width="5" fill="none"/>`));
B.push(`<rect x="60" y="40" width="360" height="70" rx="8" fill="#4a5568"/>`);
for (let k = 0; k < 14; k++) B.push(`<rect x="${78 + k * 25}" y="48" width="8" height="54" fill="#2f3848"/>`);
B.push(`<rect x="110" y="190" width="320" height="320" rx="16" fill="#1a2a3a" stroke="#8794ab" stroke-width="4"/><rect x="145" y="225" width="250" height="250" rx="14" fill="url(#sgB)" stroke="#e8eef7" stroke-opacity="0.5" stroke-width="3"/><text x="270" y="368" text-anchor="middle" font-family="JetBrains Mono, monospace" font-weight="800" font-size="72" fill="#2b3a55">CPU</text>`);
for (let i = 0; i < 4; i++) {
  const x = 620 + i * 100;
  B.push(`<rect x="${x}" y="110" width="56" height="560" rx="6" fill="#0a0d12" stroke="#3a4252" stroke-width="3"/><rect x="${x - 6}" y="92" width="68" height="14" rx="3" fill="#cbd5e1"/><rect x="${x - 6}" y="674" width="68" height="14" rx="3" fill="#cbd5e1"/>`);
  if (i === 1 || i === 3) {
    B.push(`<rect x="${x + 6}" y="122" width="44" height="536" rx="3" fill="#1d6a47"/>`);
    for (let k = 0; k < 8; k++) B.push(`<rect x="${x + 11}" y="${138 + k * 62}" width="34" height="48" rx="3" fill="#0b0f14" stroke="#2a3340" stroke-width="2"/>`);
    for (let k = 0; k < 20; k++) B.push(`<rect x="${x + 8}" y="${646 + 0}" width="0" height="0"/>`);
  }
}
B.push(`<rect x="980" y="520" width="140" height="140" rx="10" fill="#3b4a63" stroke="#5a6c8c" stroke-width="3"/>`);
B.push(`<rect x="460" y="716" width="700" height="26" rx="5" fill="#0a0d12" stroke="#3a4252" stroke-width="3"/>`);
$("bsvg").innerHTML = B.join("");
// ---- close-up
$("dimm").innerHTML = hw.dimm("d", 1500);
for (let i = 0; i < 8; i++) { const c = $("dchip" + i); }
const px0 = 33;
for (let i = 0; i < 7; i++) {
  const x = px0 + i * 164, v = vals[i];
  $("pc").insertAdjacentHTML("beforeend", `<div style="position:absolute;left:${x}px;top:90px;width:150px;height:110px;border-radius:12px;background:#0e1626;border:3px solid ${v ? "#22d3ee" : "#26365a"}"></div><div id="pv${i}" class="mono" style="position:absolute;left:${x}px;top:90px;width:150px;height:110px;display:flex;align-items:center;justify-content:center;font-size:52px;color:#34d399;opacity:0">${v || ""}</div><div id="pa${i}" class="mono" style="position:absolute;left:${x}px;top:215px;width:150px;text-align:center;font-size:32px;color:#9fb2cf">${999 + i}</div>`);
}
// ---- timeline
tl.set("#board", { transformOrigin: "748px 300px" }, 0);
tl.set("#scB", { opacity: 0 }, 0);
hide("#scA", T[5] - 0.45, 0.4);
show("#board", T[5], 0.5);
show("#bl1", T[5] + 0.9); show("#bl2", T[5] + 1.6);
tl.to("#slotHi", { opacity: 1, duration: 0.3 }, T[5] + 2.6); pulse("#slotHi", T[5] + 3.2, 1.08);
tl.to("#board", { scale: 3.2, duration: 1.7, ease: "power2.inOut" }, T[6]);
hide("#board", T[6] + 1.5, 0.35);
tl.set("#dimm", { rotation: 90, scale: 0.4 }, 0);
tl.to("#scB", { opacity: 1, duration: 0.3 }, T[6] + 1.5);
tl.to("#dimm", { rotation: 0, scale: 1, duration: 0.9, ease: "power3.out" }, T[6] + 1.5);
show("#dlab", T[6] + 2.5);
tl.to("#dchip3", { stroke: "#22d3ee", strokeWidth: 8, duration: 0.3 }, T[6] + 3.0);
show("#wire", T[6] + 3.2, 0.3); show("#clab", T[6] + 3.3); show("#panel", T[6] + 3.4, 0.4);
for (let i = 1; i <= 5; i++) show("#pv" + i, T[7] + 0.1 + (i - 1) * 0.25, 0.2);
show("#cap", T[7] + 1.3); pulse("#panel", T[7] + 1.7, 1.03);
hide("#cap", CL - 0.35, 0.3); hide("#dlab", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
