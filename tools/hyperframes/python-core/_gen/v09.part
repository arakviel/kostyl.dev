  <div id="b2" class="bx" style="left:690px;border-color:#22d3ee;color:#22d3ee"><span>компілятор</span><span style="font-size:30px;color:#9fb2cf">CPython</span></div>
  <div id="b3" class="bx" style="left:990px;border-color:#22d3ee;color:#22d3ee"><span>байт-код</span><span style="font-size:30px;color:#9fb2cf">команди</span></div>
  <div id="b4" class="bx" style="left:1290px;border-color:#22d3ee;color:#22d3ee"><span>PVM</span><span style="font-size:30px;color:#9fb2cf">виконує</span></div>
  <div id="b5" class="bx mono" style="left:1590px;border-color:#34d399;color:#34d399;font-size:56px">Hello</div>
