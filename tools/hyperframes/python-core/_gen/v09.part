<script>
/*PRE*/
// L1 0.5-1.61: recap + flow appears
tl.set("#b0", { opacity: 1 }, 0);
for (let i = 1; i < 6; i++) show("#b" + i, 0.6 + i * 0.35, 0.3);
for (let i = 0; i < 5; i++) show("#ar" + i, 0.9 + i * 0.35, 0.2);
// L2 2.26-4.49: everything is numbers
pulse("#b1", 2.6, 1.08); show("#t1", 3.0);
// L3 5.14-9.23: code is translated
pulse("#b2", 5.6, 1.08); pulse("#b3", 7.0, 1.08);
// L4 9.88-13.73
show("#t2", 10.3); pulse("#b2", 10.6, 1.08); pulse("#b3", 11.0, 1.08);
show("#t3", 11.9); pulse("#b4", 12.2, 1.08); pulse("#b5", 12.8, 1.1);
window.__timelines["world"] = tl;
</script>
