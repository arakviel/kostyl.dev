<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="b0" class="bx" style="left:90px;border-color:#fbbf24;color:#fbbf24"><span class="mono">hello.py</span><span style="font-size:30px;color:#9fb2cf">диск</span></div>
