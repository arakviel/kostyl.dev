<style>
.bx { position: absolute; top: 330px; width: 240px; height: 150px; border-radius: 18px; background: #0e1626; border: 4px solid #26365a; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; opacity: 0; text-align: center; line-height: 1.2; }
