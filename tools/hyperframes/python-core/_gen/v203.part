<style>
.tx3 { position: absolute; left: 32px; height: 52px; display: flex; align-items: center; font-family: "JetBrains Mono", monospace; font-weight: 500; font-size: 40px; color: #d4d4d4; white-space: pre; opacity: 0; }
.tx3 .ty { display: inline-block; overflow: hidden; white-space: pre; width: 0; vertical-align: bottom; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
 <div id="win" class="vsw" style="left:260px;top:100px;width:1400px;height:870px;background:#1c1c1e;border-color:#3a3a3a">
  <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">python3 — REPL</div></div>
  <div id="lines"></div>
  <div id="an" class="abs" style="left:420px;top:742px;font-size:34px;font-weight:700;color:#fbbf24;opacity:0;white-space:nowrap">← залежить від запуску</div>
 </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const P = '<span style="color:#3794ff">&gt;&gt;&gt;&nbsp;</span>';
const rows = [
  ["type(42)", "<class 'int'>"], ["type(3.14)", "<class 'float'>"], ["type('hi')", "<class 'str'>"],
  ["type(True)", "<class 'bool'>"], ["type(None)", "<class 'NoneType'>"], ["id(42)", "4380162600"],
];
rows.forEach(([c, o], k) => {
  const y = 80 + k * 2 * 62;
  $("lines").insertAdjacentHTML("beforeend", `<div id="c${k}" class="tx3" style="top:${y}px">${P}<span id="cy${k}" class="ty">${c}</span></div><div id="o${k}" class="tx3" style="top:${y + 62}px;color:${k === 5 ? "#fbbf24" : "#34d399"}">${o.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</div>`);
});
const run = (k, at, d) => { show("#c" + k, at, 0.05); typeIn("#cy" + k, rows[k][0].length, at + 0.05, d); show("#o" + k, at + d + 0.2, 0.05); };
run(0, T[0] + 0.5, 0.8);
pulse("#o0", T[1] + 0.3, 1.1);
run(1, T[1] + 1.2, 0.9); run(2, T[1] + 3.4, 0.8);
run(3, T[2] + 0.4, 0.8); run(4, T[2] + 2.0, 0.8);
run(5, T[3] + 0.4, 0.6); show("#an", T[3] + 2.4, 0.3); pulse("#o5", T[3] + 3.4, 1.08);
hide("#win", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
