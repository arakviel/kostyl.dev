show("#r3", T[3] + 2.6); show("#r4", T[3] + 4.0);
// L5 sum of errors differs from 0.3
show("#r5", T[4] + 0.6); show("#ne", T[4] + 1.4); pulse("#ne", T[4] + 1.8, 1.12); pulse("#r4", T[4] + 2.4, 1.02);
