<script>
/*PRE*/
/*HW*/
/*T*/
// L1 add 0.1 and 0.2
show("#h2", T[0] + 0.5, 0.2); show("#o2", T[0] + 1.6, 0.1); pulse("#o2", T[0] + 1.6, 1.06);
// L2 not equal to 0.3
tl.set("#h2", { y: 54 }, T[1] + 0.4); show("#o3", T[1] + 1.2, 0.1); pulse("#o3", T[1] + 1.2, 1.1);
pulse("#o2", T[1] + 3.0, 1.04);
// L3 no finite binary form: show stored values
hide("#h2", T[2] + 0.1, 0.2);
show("#tab", T[2] + 0.4, 0.3); show("#r1", T[2] + 1.2); show("#r2", T[2] + 2.4);
