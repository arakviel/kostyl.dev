<style>
.cd8 { position: absolute; width: 820px; height: 330px; border-radius: 20px; background: #0e1626; border: 4px solid #26365a; }
.ct { position: absolute; left: 28px; top: 20px; font-size: 38px; font-weight: 700; }
.cb { position: absolute; opacity: 0; }
.dgm { position: absolute; top: 130px; width: 160px; height: 130px; border-radius: 12px; background: #0b1322; border: 3px solid #26365a; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-weight: 800; font-size: 40px; color: #34d399; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
 <div id="all">
  <div id="c1" class="cd8" style="left:100px;top:240px;border-color:#34d399"><div class="ct" style="color:#34d399">Усе — об'єкт</div>
    <div id="c1a" class="cb mono" style="left:30px;top:100px;font-size:46px;color:#22d3ee">тип: int</div>
    <div id="c1b" class="cb mono" style="left:30px;top:170px;font-size:46px;color:#fbbf24">id: 4380162600</div>
    <div id="c1c" class="cb mono" style="left:30px;top:240px;font-size:46px;color:#34d399">значення: 42</div></div>
  <div id="c2" class="cd8" style="left:1000px;top:240px;border-color:#22d3ee"><div class="ct" style="color:#22d3ee">int: довільна точність</div>
    <div id="c2a" class="cb" style="left:0;top:0;width:820px;height:330px"><div class="dgm" style="left:40px">1024</div><div class="dgm" style="left:230px;color:#9fb2cf">0</div><div class="dgm" style="left:420px;color:#9fb2cf">0</div><div class="dgm" style="left:610px;color:#9fb2cf">0</div></div>
    <div id="c2b" class="cb lab" style="left:0;width:820px;text-align:center;top:275px;color:#22d3ee;font-size:32px">2**100 = 4 цифри по 30 біт</div></div>
  <div id="c3" class="cd8" style="left:100px;top:620px;border-color:#fbbf24"><div class="ct" style="color:#fbbf24">float: IEEE 754</div>
    <div id="c3a" class="cb mono" style="left:0;width:820px;text-align:center;top:110px;font-size:46px;color:#d4d4d4">0.1 + 0.2 == 0.3</div>
    <div id="c3b" class="cb mono" style="left:0;width:820px;text-align:center;top:190px;font-size:56px;color:#fb7185">False</div>
    <div id="c3c" class="cb mono" style="left:0;width:820px;text-align:center;top:260px;font-size:36px;color:#9fb2cf">0.30000000000000004</div></div>
  <div id="c4" class="cd8" style="left:1000px;top:620px;border-color:#fb7185"><div class="ct" style="color:#fb7185">bool і None</div>
    <div id="c4a" class="cb mono" style="left:30px;top:110px;font-size:44px;color:#d4d4d4">True + True <span style="color:#9fb2cf">→</span> <span style="color:#b5cea8">2</span></div>
    <div id="c4b" class="cb mono" style="left:30px;top:200px;font-size:44px;color:#d4d4d4">None is None <span style="color:#9fb2cf">→</span> <span style="color:#34d399">True</span></div></div>
 </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
pulse("#c1", 1.0, 1.04); pulse("#c2", 1.4, 1.04); pulse("#c3", 1.8, 1.04); pulse("#c4", 2.2, 1.04);
// L2 object
show("#c1a", T[1] + 0.8); show("#c1b", T[1] + 1.8); show("#c1c", T[1] + 2.8); pulse("#c1", T[1] + 3.2, 1.03);
// L3 int
show("#c2a", T[2] + 0.8); show("#c2b", T[2] + 2.4); pulse("#c2", T[2] + 3.0, 1.03);
// L4 float
show("#c3a", T[3] + 1.0); show("#c3b", T[3] + 4.0); show("#c3c", T[3] + 6.0); pulse("#c3", T[3] + 6.4, 1.03);
pulse("#c3b", T[3] + 7.3, 1.1); pulse("#c3c", T[3] + 8.2, 1.06); pulse("#c3", T[3] + 9.0, 1.03);
// L5 bool / None
show("#c4a", T[4] + 0.8); show("#c4b", T[4] + 2.6); pulse("#c4", T[4] + 3.4, 1.03);
window.__timelines["world"] = tl;
</script>
