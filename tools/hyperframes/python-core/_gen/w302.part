<style>
.bc2 { position: absolute; top: 500px; width: 170px; height: 120px; border-radius: 14px; background: #0e1626; border: 4px solid #26365a; opacity: 1; }
.bv2 { position: absolute; top: 500px; width: 170px; height: 120px; display: flex; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 30px; color: #34d399; opacity: 0; }
.ad2 { position: absolute; top: 640px; width: 170px; text-align: center; font-family: "JetBrains Mono", monospace; font-size: 30px; color: #9fb2cf; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="ed" class="vsw" style="left:160px;top:120px;width:760px;height:310px;opacity:0">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">var.c</div></div>
    <div class="vsr"></div><div class="vst">var.c</div>
    <div id="l1" class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#569cd6">int</span> <span style="color:#9cdcfe">x</span> = <span style="color:#b5cea8">5</span>;</span></div>
    <div id="l2" class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">x</span> = <span style="color:#b5cea8">7</span>;</span></div>
    <div id="hl" style="position:absolute;left:0;width:760px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="cells"></div><div id="brace" class="abs" style="left:608px;top:690px;width:704px;height:8px;background:#fbbf24;border-radius:4px;opacity:0"></div>
  <div id="xl" class="mono abs" style="left:608px;width:704px;text-align:center;top:712px;font-size:40px;color:#fbbf24;opacity:0">x: int, 4 байти</div>
  <div id="note" class="lab" style="left:0;width:1920px;text-align:center;top:820px;font-size:44px;color:#fbbf24;opacity:0">адреса та сама, змінився вміст</div>
  <div id="sch" class="lab" style="left:0;width:1920px;text-align:center;top:960px;font-size:30px;color:#6f84a6">схематично: адреси умовні</div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const adr = ["0x0FFE", "0x0FFF", "0x1000", "0x1001", "0x1002", "0x1003", "0x1004", "0x1005"];
const b5 = ["00000101", "00000000", "00000000", "00000000"], b7 = ["00000111", "00000000", "00000000", "00000000"];
adr.forEach((a, i) => {
  const x = 224 + i * 184 - 0, on = i >= 2 && i <= 5;
  $("cells").insertAdjacentHTML("beforeend", `<div id="bc${i}" class="bc2" style="left:${x}px;border-color:${on ? "#fbbf24" : "#26365a"}"></div><div id="ad${i}" class="ad2" style="left:${x}px">${a}</div>` + (on ? `<div id="v5_${i}" class="bv2" style="left:${x}px">${b5[i - 2]}</div><div id="v7_${i}" class="bv2" style="left:${x}px;color:#fb7185">${b7[i - 2]}</div>` : ""));
});
// brace over cells 2..5 : x = 224 + 2*184 .. 224 + 5*184 + 170
document.getElementById("brace").style.left = "592px"; document.getElementById("brace").style.width = "722px";
document.getElementById("xl").style.left = "592px"; document.getElementById("xl").style.width = "722px";
// L1 variable in C = cell with an address
for (let i = 0; i < 8; i++) pulse("#bc" + i, T[0] + 0.8 + i * 0.3, 1.03);
// L2 int x = 5
show("#ed", T[1] + 0.2, 0.3); tl.to("#hl", { opacity: 1, duration: 0.2 }, T[1] + 0.8);
show("#brace", T[1] + 1.6); show("#xl", T[1] + 1.7);
for (let i = 2; i <= 5; i++) show("#v5_" + i, T[1] + 2.6 + (i - 2) * 0.3, 0.2);
// L3 x = 7 : same bytes, new content
tl.set("#hl", { y: 54 }, T[2] + 0.3);
for (let i = 2; i <= 5; i++) { hide("#v5_" + i, T[2] + 1.3, 0.15); show("#v7_" + i, T[2] + 1.45, 0.15); }
pulse("#v7_2", T[2] + 1.6, 1.15); for (let i = 2; i <= 5; i++) pulse("#bc" + i, T[2] + 2.4 + (i - 2) * 0.4, 1.04);
// L4 address stays
tl.to("#ad2", { color: "#fbbf24", duration: 0.2 }, T[3] + 0.2);
show("#note", T[3] + 0.8); pulse("#note", T[3] + 1.8, 1.04);
hide("#ed", CL - 0.35, 0.3); hide("#note", CL - 0.35, 0.2); hide("#xl", CL - 0.35, 0.2);
window.__timelines["world"] = tl;
</script>
