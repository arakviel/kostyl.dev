<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:100px;top:100px;width:1720px;height:290px;opacity:0">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">names.py</div></div>
    <div class="vsr"></div><div class="vst">names.py</div>
    <div id="e1" class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">x</span> = <span style="color:#b5cea8">5</span></span></div>
    <div id="e2" class="vsl" style="top:172px;opacity:0"><span class="n">2</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span><span style="color:#ffd700">(</span>{<span style="color:#9cdcfe">k</span>: <span style="color:#9cdcfe">v</span> <span style="color:#c586c0">for</span> <span style="color:#9cdcfe">k</span>, <span style="color:#9cdcfe">v</span> <span style="color:#c586c0">in</span> <span style="color:#dcdcaa">globals</span>().<span style="color:#dcdcaa">items</span>() <span style="color:#c586c0">if not</span> <span style="color:#9cdcfe">k</span>.<span style="color:#dcdcaa">startswith</span>(<span style="color:#ce9178">"__"</span>)}<span style="color:#ffd700">)</span></span></div>
    <div id="hl" style="position:absolute;left:0;width:1720px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="nsw"></div><div id="obw"></div>
  <div id="q" class="mono abs" style="left:1040px;top:520px;font-size:120px;color:#fbbf24;opacity:0">?</div>
  <div id="st1" class="lab" style="left:700px;top:790px;font-size:36px;color:#34d399;opacity:0">1 · об'єкт створено</div>
  <div id="st2" class="lab" style="left:700px;top:845px;font-size:36px;color:#22d3ee;opacity:0">2 · ім'я прив'язано</div>
  <div id="term" class="vsw" style="left:1180px;top:470px;width:640px;height:230px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="out" class="vsx" style="top:80px;font-size:44px;color:#34d399;font-weight:700">{'x': 5}</div>
  </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 180, 470, [["x", CC.c]]);
$("obw").innerHTML = OB("ob", 700, 470, "int", "5", "#34d399", "4353553800");
ARW("ar", 450, 590, 694, 590, CC.c);
tl.set("#ed", { opacity: 1 }, 0); tl.to("#hl", { opacity: 1, duration: 0.2 }, T[0] + 0.3);
// L1 a name is an arrow, not a cell
show("#ns", T[0] + 0.8, 0.3); show("#nsn0", T[0] + 1.3, 0.3); show("#q", T[0] + 2.2); pulse("#q", T[0] + 2.8, 1.15);
// L2 it points to an object in memory
hide("#q", T[1] + 0.1, 0.2); show("#ob", T[1] + 0.4, 0.3); show("#ar", T[1] + 1.2, 0.3);
pulse("#nsn0", T[1] + 1.9, 1.1); pulse("#ob", T[1] + 2.6, 1.04); pulse("#ob", T[2] + 0.3, 1.04);
// L3 assignment creates the object and binds the name
pulse("#ob", T[2] + 1.2, 1.05); show("#st1", T[2] + 1.2); pulse("#ar", T[2] + 3.0, 1.0); show("#st2", T[2] + 3.0); pulse("#nsn0", T[2] + 3.2, 1.1);
// L4 globals() shows the table
hide("#st1", T[3] + 0.1, 0.2); hide("#st2", T[3] + 0.1, 0.2);
show("#e2", T[3] + 0.4, 0.3); tl.set("#hl", { y: 54 }, T[3] + 0.4);
show("#term", T[3] + 1.8, 0.3); show("#out", T[3] + 2.4, 0.1); pulse("#out", T[3] + 2.4, 1.08); pulse("#ns", T[3] + 3.4, 1.04);
hide("#ed", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
