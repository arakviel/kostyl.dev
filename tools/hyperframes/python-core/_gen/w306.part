<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:80px;top:130px;width:700px;height:260px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">alias.py</div></div>
    <div class="vsr"></div><div class="vst">alias.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span> = [<span style="color:#b5cea8">1</span>, <span style="color:#b5cea8">2</span>]</span></div>
    <div id="l2" class="vsl" style="top:172px;opacity:0"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">b</span> = <span style="color:#9cdcfe">a</span></span></div>
    <div id="hl" style="position:absolute;left:0;width:700px;height:54px;top:172px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="cp" class="lab" style="left:80px;top:430px;font-size:38px;color:#fb7185;opacity:0;white-space:nowrap">значення не копіюється</div>
  <div id="cnt" class="mono abs" style="left:80px;top:500px;font-size:42px;opacity:0;white-space:nowrap"><span style="color:#22d3ee">імена: 2</span>    <span style="color:#34d399">об'єкт: 1</span></div>
  <div id="term" class="vsw" style="left:80px;top:600px;width:760px;height:330px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="o1" class="vsx" style="top:70px;font-size:34px">id(a)  →  4355319552</div>
    <div id="o2" class="vsx" style="top:128px;font-size:34px">id(b)  →  4355319552</div>
    <div id="o3" class="vsx" style="top:196px;font-size:40px;color:#34d399;font-weight:700">a is b  →  True</div>
  </div>
  <div id="nsw"></div><div id="obw"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 900, 210, [["a", CC.c], ["b", CC.a]]);
$("obw").innerHTML = OB("ob", 1400, 250, "list", "[1, 2]", "#34d399", "4355319552");
ARW("aa", NSX(900), NSY(210, 0), 1394, 340, CC.c);
ARW("ab", NSX(900), NSY(210, 1), 1394, 380, CC.a);
tl.set(["#ns", "#nsn0", "#ob", "#aa"], { opacity: 1 }, 0);
// L1 b = a: nothing is copied
show("#l2", T[0] + 0.4, 0.2); show("#hl", T[0] + 0.6, 0.2); show("#cp", T[0] + 1.8); pulse("#ob", T[0] + 2.4, 1.03);
// L2 a second arrow
show("#nsn1", T[1] + 0.3, 0.3); show("#ab", T[1] + 1.0, 0.3);
// L3 two names, one object
hide("#cp", T[2] + 0.1, 0.2); show("#cnt", T[2] + 0.3); pulse("#cnt", T[2] + 1.0, 1.04);
// L4 the same id
show("#term", T[3] + 0.0, 0.3); show("#o1", T[3] + 0.3, 0.1); show("#o2", T[3] + 0.7, 0.1); show("#o3", T[3] + 1.3, 0.1); pulse("#o3", T[3] + 1.4, 1.08);
hide("#ed", CL - 0.35, 0.3); hide("#cnt", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
