<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:80px;top:130px;width:700px;height:400px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">refs.py</div></div>
    <div class="vsr"></div><div class="vst">refs.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span> = [<span style="color:#b5cea8">1</span>, <span style="color:#b5cea8">2</span>]</span></div>
    <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">b</span> = <span style="color:#9cdcfe">a</span></span></div>
    <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre"><span style="color:#c586c0">del</span> <span style="color:#9cdcfe">b</span></span></div>
    <div class="vsl" style="top:280px"><span class="n">4</span><span style="white-space:pre"><span style="color:#c586c0">del</span> <span style="color:#9cdcfe">a</span></span></div>
    <div id="hl" style="position:absolute;left:0;width:700px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="bd" class="abs" style="left:1700px;top:150px;width:150px;height:150px;border-radius:75px;border:6px solid #fbbf24;opacity:0"><div id="bn1" class="mono abs" style="left:0;width:150px;top:30px;text-align:center;font-size:80px;color:#fbbf24;opacity:0">1</div><div id="bn2" class="mono abs" style="left:0;width:150px;top:30px;text-align:center;font-size:80px;color:#fbbf24;opacity:0">2</div><div id="bn0" class="mono abs" style="left:0;width:150px;top:30px;text-align:center;font-size:80px;color:#fb7185;opacity:0">0</div></div>
  <div id="bl" class="lab" style="left:1420px;top:100px;font-size:34px;color:#fbbf24;opacity:0;white-space:nowrap;text-align:center;width:420px">лічильник</div>
  <div id="term" class="vsw" style="left:80px;top:590px;width:760px;height:300px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">sys.getrefcount(a) − 1</div></div>
    <div id="o1" class="vsx" style="top:70px;font-size:40px">1</div><div id="o2" class="vsx" style="top:128px;font-size:40px">2</div><div id="o3" class="vsx" style="top:186px;font-size:40px">1</div>
  </div>
  <div id="gone" class="lab" style="left:880px;top:880px;font-size:42px;color:#fb7185;opacity:0;white-space:nowrap">лічильник 0 → об'єкт видалено</div>
  <div id="nsw"></div><div id="obw"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 880, 260, [["a", CC.c], ["b", CC.a]]);
$("obw").innerHTML = OB("ob", 1400, 340, "list", "[1, 2]", "#34d399", "4355319552");
ARW("aa", NSX(880), NSY(260, 0), 1394, 430, CC.c);
ARW("ab", NSX(880), NSY(260, 1), 1394, 470, CC.a);
tl.set("#ed", { opacity: 1 }, 0);
const setN = (k, at) => { ["bn0", "bn1", "bn2"].forEach((n) => tl.set("#" + n, { opacity: n === "bn" + k ? 1 : 0 }, at)); };
// L1 counted automatically
show("#ob", T[0] + 0.6, 0.3); show("#bd", T[0] + 1.6, 0.3); show("#bl", T[0] + 1.8); show("#ns", T[0] + 2.4, 0.3);
// L2 a = [1, 2]: 1 arrow
tl.set("#hl", { y: 0, opacity: 1 }, T[1] + 0.3); show("#nsn0", T[1] + 0.8, 0.3); show("#aa", T[1] + 1.4, 0.3);
setN(1, T[1] + 1.8); pulse("#bd", T[1] + 1.9, 1.15); show("#term", T[1] + 2.4, 0.3); show("#o1", T[1] + 3.0, 0.1);
// L3 b = a: 2 arrows
tl.set("#hl", { y: 54 }, T[2] + 0.3); show("#nsn1", T[2] + 0.8, 0.3); show("#ab", T[2] + 1.4, 0.3);
setN(2, T[2] + 1.8); pulse("#bd", T[2] + 1.9, 1.15); show("#o2", T[2] + 2.6, 0.1);
// L4 del b, del a
tl.set("#hl", { y: 108 }, T[3] + 0.3); hide("#nsn1", T[3] + 0.8, 0.3); hide("#ab", T[3] + 0.8, 0.3);
setN(1, T[3] + 1.2); pulse("#bd", T[3] + 1.3, 1.15); show("#o3", T[3] + 1.6, 0.1);
tl.set("#hl", { y: 162 }, T[3] + 2.6); hide("#nsn0", T[3] + 3.1, 0.3); hide("#aa", T[3] + 3.1, 0.3);
setN(0, T[3] + 3.6); pulse("#bd", T[3] + 3.7, 1.2);
pulse("#bd", T[4] + 0.4, 1.1); pulse("#term", T[4] + 1.2, 1.02);
// L5 removed
tl.to("#ob", { opacity: 0.2, duration: 0.8 }, T[4] + 2.0); show("#gone", T[4] + 2.2); pulse("#bd", T[4] + 4.2, 1.1);
hide("#ed", CL - 0.35, 0.3); hide("#bl", CL - 0.35, 0.3); hide("#bd", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
