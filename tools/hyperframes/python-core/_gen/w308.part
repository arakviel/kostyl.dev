<style>
.res { position: absolute; left: 30px; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 38px; white-space: nowrap; opacity: 0; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="A">
    <div id="ed" class="vsw" style="left:80px;top:130px;width:700px;height:320px">
      <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">compare.py</div></div>
      <div class="vsr"></div><div class="vst">compare.py</div>
      <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span> = [<span style="color:#b5cea8">1</span>, <span style="color:#b5cea8">2</span>]</span></div>
      <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">b</span> = <span style="color:#9cdcfe">a</span></span></div>
      <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre"><span style="color:#9cdcfe">c</span> = [<span style="color:#b5cea8">1</span>, <span style="color:#b5cea8">2</span>]</span></div>
    </div>
    <div id="nsw"></div><div id="obw"></div>
    <div id="rs" class="card" style="left:80px;top:520px;width:760px;height:260px;opacity:0">
      <div id="r1" class="res" style="top:30px"><span style="color:#d4d4d4">a == c</span>  <span style="color:#9fb2cf">→</span>  <span style="color:#34d399">True</span></div>
      <div id="r2" class="res" style="top:100px"><span style="color:#d4d4d4">a is c</span>  <span style="color:#9fb2cf">→</span>  <span style="color:#fb7185">False</span></div>
      <div id="r3" class="res" style="top:170px"><span style="color:#d4d4d4">a is b</span>  <span style="color:#9fb2cf">→</span>  <span style="color:#34d399">True</span></div>
    </div>
    <div id="cap" class="lab" style="left:80px;top:830px;font-size:38px;color:#fbbf24;opacity:0;white-space:nowrap">== значення · is — той самий об'єкт</div>
  </div>
  <div id="B" style="opacity:0">
    <div class="lab" style="left:0;width:1920px;text-align:center;top:150px;font-size:44px;color:#e8eef7">кеш малих цілих у Python 3.15</div>
    <div class="abs" style="left:300px;top:420px;width:1320px;height:8px;background:#3a4a6e"></div>
    <div id="band" class="abs" style="left:340px;top:400px;width:440px;height:48px;border-radius:10px;background:rgba(52,211,153,0.35);border:4px solid #34d399"></div>
    <div class="mono abs" style="left:300px;top:470px;font-size:34px;color:#34d399">−5</div>
    <div class="mono abs" style="left:700px;top:470px;font-size:34px;color:#34d399">1024</div>
    <div id="mk" class="mono abs" style="left:1360px;top:340px;width:240px;text-align:center;font-size:36px;color:#fb7185;opacity:0">100000</div>
    <div id="mkb" class="abs" style="left:1470px;top:392px;width:20px;height:64px;border-radius:10px;background:#fb7185;opacity:0"></div>
    <div id="bl" class="lab" style="left:340px;top:520px;font-size:36px;color:#34d399;opacity:0">кеш: готові об'єкти повторно використовуються</div>
    <div class="lab" style="left:300px;top:600px;font-size:28px;color:#6f84a6">шкала умовна, не в масштабі</div>
    <div id="rs2" class="card" style="left:260px;top:650px;width:1400px;height:200px;opacity:0">
      <div id="q1" class="res" style="top:26px;font-size:38px"><span style="color:#d4d4d4">int("1000") is int("1000")</span>  <span style="color:#9fb2cf">→</span>  <span style="color:#34d399">True</span></div>
      <div id="q2" class="res" style="top:96px;font-size:38px"><span style="color:#d4d4d4">int("100000") is int("100000")</span>  <span style="color:#9fb2cf">→</span>  <span style="color:#fb7185">False</span></div>
    </div>
    <div id="det" class="lab" style="left:0;width:1920px;text-align:center;top:900px;font-size:40px;color:#fbbf24;opacity:0">деталь реалізації: не покладайтеся на is для чисел</div>
  </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 880, 130, [["a", CC.c], ["b", CC.a], ["c", CC.e]]);
$("obw").innerHTML = OB("o1", 1400, 130, "list", "[1, 2]", "#34d399", "4355319552") + OB("o2", 1400, 480, "list", "[1, 2]", "#34d399", "4355156992");
ARW("aa", NSX(880), NSY(130, 0), 1394, 245, CC.c);
ARW("ab", NSX(880), NSY(130, 1), 1394, 270, CC.a);
ARW("ac", NSX(880), NSY(130, 2), 1394, 595, CC.e);
tl.set(["#ns", "#nsn0", "#nsn1", "#nsn2", "#o1", "#o2", "#aa", "#ab", "#ac"], { opacity: 1 }, 0);
// L1 == compares values, is compares objects
show("#cap", T[0] + 1.4); pulse("#cap", T[0] + 2.6, 1.03); pulse("#o1", T[0] + 3.2, 1.03); pulse("#o2", T[0] + 3.8, 1.03);
// L2 a == c, a is c
show("#rs", T[1] + 0.2, 0.3); show("#r1", T[1] + 0.8, 0.1); pulse("#r1", T[1] + 0.9, 1.04);
show("#r2", T[1] + 2.6, 0.1); pulse("#r2", T[1] + 2.7, 1.06); pulse("#ac", T[1] + 2.9, 1.0);
pulse("#rs", T[2] + 0.3, 1.02); pulse("#o1", T[2] + 0.9, 1.03);
// L3 a is b
show("#r3", T[2] + 1.6, 0.1); pulse("#r3", T[2] + 1.7, 1.06); pulse("#ab", T[2] + 1.9, 1.0); pulse("#aa", T[2] + 2.3, 1.0);
pulse("#o1", T[2] + 3.4, 1.04); pulse("#r3", T[2] + 4.4, 1.04);
// L4 small ints cache
hide("#A", T[3] - 0.1, 0.3); ["#aa", "#ab", "#ac"].forEach((x) => hide(x, T[3] - 0.1, 0.3)); tl.to("#B", { opacity: 1, duration: 0.3 }, T[3] + 0.3);
show("#bl", T[3] + 1.4); pulse("#band", T[3] + 3.0, 1.04); pulse("#band", T[3] + 5.0, 1.04);
// L5 results and a warning
show("#rs2", T[4] + 0.2, 0.3); show("#q1", T[4] + 0.8, 0.1); show("#mk", T[4] + 2.4); show("#mkb", T[4] + 2.4); show("#q2", T[4] + 3.0, 0.1); pulse("#q2", T[4] + 3.1, 1.04);
show("#det", T[4] + 4.8); pulse("#det", T[4] + 5.8, 1.03);
hide("#B", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
