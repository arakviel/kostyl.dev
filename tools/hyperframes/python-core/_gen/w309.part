<style>
.drow { position: absolute; left: 0; width: 700px; height: 54px; display: flex; align-items: center; padding-left: 24px; font-family: "JetBrains Mono", monospace; font-weight: 600; font-size: 32px; color: #d4d4d4; white-space: pre; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:80px;top:100px;width:700px;height:320px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">swap.py</div></div>
    <div class="vsr"></div><div class="vst">swap.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span> = <span style="color:#ce9178">"ліво"</span></span></div>
    <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">b</span> = <span style="color:#ce9178">"право"</span></span></div>
    <div id="l3" class="vsl" style="top:226px;opacity:0"><span class="n">3</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span>, <span style="color:#9cdcfe">b</span> = <span style="color:#9cdcfe">b</span>, <span style="color:#9cdcfe">a</span></span></div>
    <div id="hl" style="position:absolute;left:0;width:700px;height:54px;top:226px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="tmp" class="card" style="left:80px;top:450px;width:700px;height:150px;opacity:0;border-color:#fbbf24">
    <div class="lab" style="left:20px;top:10px;font-size:30px;color:#fbbf24">права частина (обчислена)</div>
    <div id="t1" class="mono abs" style="left:30px;top:62px;width:300px;height:70px;border:4px solid #34d399;border-radius:12px;color:#34d399;font-size:40px;display:flex;align-items:center;justify-content:center;opacity:0">"право"</div>
    <div id="t2" class="mono abs" style="left:370px;top:62px;width:300px;height:70px;border:4px solid #34d399;border-radius:12px;color:#34d399;font-size:40px;display:flex;align-items:center;justify-content:center;opacity:0">"ліво"</div>
  </div>
  <div id="dis" class="card" style="left:80px;top:640px;width:700px;height:360px;opacity:0">
    <div class="lab" style="left:20px;top:8px;font-size:30px">байт-код (dis, Python 3.15)</div>
    <div id="d1" class="drow" style="top:56px">LOAD_NAME    b</div>
    <div id="d2" class="drow" style="top:112px">LOAD_NAME    a</div>
    <div id="d3" class="drow" style="top:168px">SWAP         2</div>
    <div id="d4" class="drow" style="top:224px">STORE_NAME   a</div>
    <div id="d5" class="drow" style="top:280px">STORE_NAME   b</div>
  </div>
  <div id="nt" class="lab" style="left:850px;top:880px;font-size:42px;color:#fbbf24;opacity:0;white-space:nowrap">тимчасовий кортеж не створюється</div>
  <div id="nsw"></div><div id="obw"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 900, 170, [["a", CC.c], ["b", CC.a]]);
$("obw").innerHTML = OB("ol", 1400, 150, "str", '"ліво"', "#34d399", "4357889264") + OB("or", 1400, 520, "str", '"право"', "#34d399", "4358355216");
ARW("al", NSX(900), NSY(170, 0), 1394, 265, CC.c);
ARW("bp", NSX(900), NSY(170, 1), 1394, 635, CC.a);
ARW("ap", NSX(900), NSY(170, 0), 1394, 600, CC.c);
ARW("bl", NSX(900), NSY(170, 1), 1394, 300, CC.a);
tl.set(["#ns", "#nsn0", "#nsn1", "#ol", "#or", "#al", "#bp"], { opacity: 1 }, 0);
const dh = (id, at) => { tl.to("#" + id, { backgroundColor: "#16294a", duration: 0.15 }, at); tl.to("#" + id, { backgroundColor: "rgba(0,0,0,0)", duration: 0.15 }, at + 0.8); };
// L1 no third variable
pulse("#ol", T[0] + 1.0, 1.04); pulse("#or", T[0] + 1.8, 1.04);
// L2 a = "ліво", b = "право"
pulse("#nsn0", T[1] + 0.4, 1.1); pulse("#nsn1", T[1] + 1.6, 1.1);
// L3 right-hand side first
show("#l3", T[2] + 0.2, 0.2); show("#hl", T[2] + 0.4, 0.2);
show("#tmp", T[2] + 1.0, 0.3); show("#dis", T[2] + 1.0, 0.3);
dh("d1", T[2] + 2.0); show("#t1", T[2] + 2.2, 0.2); pulse("#or", T[2] + 2.2, 1.04);
dh("d2", T[2] + 3.6); show("#t2", T[2] + 3.8, 0.2); pulse("#ol", T[2] + 3.8, 1.04);
pulse("#tmp", T[2] + 4.8, 1.02); pulse("#t1", T[2] + 5.6, 1.08); pulse("#t2", T[2] + 6.4, 1.08); pulse("#dis", T[2] + 7.0, 1.02);
// L4 both arrows are moved at once
dh("d3", T[3] + 0.4);
hide("#al", T[3] + 0.9, 0.3); hide("#bp", T[3] + 0.9, 0.3); show("#ap", T[3] + 1.3, 0.3); show("#bl", T[3] + 1.3, 0.3);
dh("d4", T[3] + 1.4); dh("d5", T[3] + 2.2);
// L5 CPython uses SWAP
tl.to("#d3", { backgroundColor: "#16294a", duration: 0.2 }, T[4] + 0.4); show("#nt", T[4] + 1.6); pulse("#nt", T[4] + 3.0, 1.03);
hide("#ed", CL - 0.35, 0.3); hide("#ol", CL - 0.35, 0.3); hide("#bl", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
