<style>
.chipx { position: absolute; top: 740px; width: 520px; height: 130px; border-radius: 18px; background: #0e1626; border: 4px solid #26365a; display: flex; align-items: center; justify-content: center; font-size: 44px; font-weight: 700; opacity: 0; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="ed" class="vsw" style="left:80px;top:110px;width:900px;height:360px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">hyp.py</div></div>
    <div class="vsr"></div><div class="vst">hyp.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">a</span> = <span style="color:#4ec9b0">float</span>(<span style="color:#dcdcaa">input</span>(<span style="color:#ce9178">"Катет a: "</span>))</span></div>
    <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">b</span> = <span style="color:#4ec9b0">float</span>(<span style="color:#dcdcaa">input</span>(<span style="color:#ce9178">"Катет b: "</span>))</span></div>
    <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre"><span style="color:#9cdcfe">c</span> = (<span style="color:#9cdcfe">a</span> ** <span style="color:#b5cea8">2</span> + <span style="color:#9cdcfe">b</span> ** <span style="color:#b5cea8">2</span>) ** <span style="color:#b5cea8">0.5</span></span></div>
    <div class="vsl" style="top:280px"><span class="n">4</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span>(<span style="color:#569cd6">f</span><span style="color:#ce9178">"Гіпотенуза: {</span><span style="color:#9cdcfe">c</span><span style="color:#ce9178">:.2f}"</span>)</span></div>
  </div>
  <div id="term" class="vsw" style="left:1020px;top:110px;width:820px;height:360px;opacity:0;background:#1c1c1e">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">Terminal</div></div>
    <div id="t0" class="vsx" style="top:70px;font-size:34px"><span style="color:#4ec9b0">lesson-04 %&nbsp;</span><span id="t0y" class="ty">python3 hyp.py</span></div>
    <div id="t1" class="vsx" style="top:130px;font-size:34px">Катет a:&nbsp;<span id="t1y" class="ty" style="color:#fbbf24">3</span></div>
    <div id="t2" class="vsx" style="top:190px;font-size:34px">Катет b:&nbsp;<span id="t2y" class="ty" style="color:#fbbf24">4</span></div>
    <div id="t3" class="vsx" style="top:250px;font-size:44px;color:#34d399;font-weight:700">Гіпотенуза: 5.00</div>
  </div>
  <div id="c1" class="chipx" style="left:80px;border-color:#22d3ee;color:#22d3ee">вирази</div>
  <div id="c2" class="chipx" style="left:700px;border-color:#fbbf24;color:#fbbf24">введення</div>
  <div id="c3" class="chipx" style="left:1320px;border-color:#34d399;color:#34d399">перетворення типів</div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
tl.set("#ed", { opacity: 1 }, 0);
pulse("#ed", T[0] + 0.8, 1.02);
// L2 asks two numbers, prints the result
show("#term", T[1] + 0.1, 0.3);
show("#t0", T[1] + 0.4, 0.05); typeIn("#t0y", 14, T[1] + 0.5, 0.8);
show("#t1", T[1] + 1.5, 0.05); typeIn("#t1y", 1, T[1] + 1.9, 0.2);
show("#t2", T[1] + 2.3, 0.05); typeIn("#t2y", 1, T[1] + 2.7, 0.2);
show("#t3", T[1] + 3.2, 0.1); pulse("#t3", T[1] + 3.3, 1.05);
// L3 what is needed
[["#c1", 0.4], ["#c2", 1.4], ["#c3", 2.4]].forEach(([s, d]) => { show(s, T[2] + d); pulse(s, T[2] + d, 1.06); });
hide("#ed", CL - 0.35, 0.3); hide("#term", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
