<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:80px;top:130px;width:760px;height:380px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">aug.py</div></div>
    <div class="vsr"></div><div class="vst">aug.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">word</span> = <span style="color:#ce9178">"ab"</span></span></div>
    <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">copy</span> = <span style="color:#9cdcfe">word</span></span></div>
    <div id="l3" class="vsl" style="top:226px;opacity:0"><span class="n">3</span><span style="white-space:pre"><span style="color:#9cdcfe">word</span> += <span style="color:#ce9178">"c"</span></span></div>
    <div id="l4" class="vsl" style="top:280px;opacity:0"><span class="n">4</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span>(<span style="color:#9cdcfe">word</span>, <span style="color:#9cdcfe">copy</span>)</span></div>
    <div id="hl" style="position:absolute;left:0;width:760px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="nt" class="lab" style="left:80px;top:560px;font-size:38px;color:#fb7185;opacity:0;white-space:nowrap">рядок незмінний: старий не змінюється</div>
  <div id="term" class="vsw" style="left:80px;top:700px;width:560px;height:200px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="o1" class="vsx" style="top:80px;font-size:50px;color:#34d399;font-weight:700">abc ab</div>
  </div>
  <div id="nsw"></div><div id="obw"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 900, 200, [["word", CC.c], ["copy", CC.a]]);
$("obw").innerHTML = OB("o1x", 1400, 180, "str", '"ab"', "#34d399", "4400078288") + OB("o2x", 1400, 540, "str", '"abc"', "#34d399", "4400439504");
ARW("w1", NSX(900), NSY(200, 0), 1394, 290, CC.c);
ARW("c1", NSX(900), NSY(200, 1), 1394, 330, CC.a);
ARW("w2", NSX(900), NSY(200, 0), 1394, 655, CC.c);
tl.set("#ed", { opacity: 1 }, 0);
// L1 += looks like in-place change
tl.set("#hl", { y: 108, opacity: 1 }, T[0] + 0.8); pulse("#ed", T[0] + 1.6, 1.02);
// L2 two names, one string
tl.set("#hl", { y: 0 }, T[1] + 0.2); show("#ns", T[1] + 0.4, 0.3); show("#nsn0", T[1] + 0.6, 0.3); show("#o1x", T[1] + 1.0, 0.3); show("#w1", T[1] + 1.6, 0.3);
tl.set("#hl", { y: 54 }, T[1] + 2.4); show("#nsn1", T[1] + 2.6, 0.3); show("#c1", T[1] + 3.2, 0.3);
// L3 new string abc
show("#l3", T[2] + 0.1, 0.2); tl.set("#hl", { y: 108 }, T[2] + 0.3); show("#nt", T[2] + 0.8); show("#o2x", T[2] + 2.0, 0.3);
// L4 the arrow of word moves
hide("#w1", T[3] + 0.3, 0.3); show("#w2", T[3] + 0.7, 0.3); pulse("#nsn0", T[3] + 1.0, 1.1); hide("#nt", T[3] + 1.2, 0.3); pulse("#c1", T[3] + 2.0, 1.0); pulse("#o1x", T[3] + 2.2, 1.04);
// L5 word = abc, copy = ab
show("#l4", T[4] + 0.0, 0.2); tl.set("#hl", { y: 162 }, T[4] + 0.1); show("#term", T[4] + 0.6, 0.3); show("#o1", T[4] + 1.2, 0.1); pulse("#o1", T[4] + 1.3, 1.08);
hide("#ed", CL - 0.35, 0.3); hide("#o1x", CL - 0.35, 0.3); hide("#c1", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
