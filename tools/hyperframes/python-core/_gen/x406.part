<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0"></svg>
  <div id="ed" class="vsw" style="left:80px;top:130px;width:760px;height:310px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">convert.py</div></div>
    <div class="vsr"></div><div class="vst">convert.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">raw</span> = <span style="color:#ce9178">"41"</span></span></div>
    <div id="l2" class="vsl" style="top:172px;opacity:0"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">number</span> = <span style="color:#4ec9b0">int</span>(<span style="color:#9cdcfe">raw</span>)</span></div>
    <div id="hl" style="position:absolute;left:0;width:760px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="n1" class="lab" style="left:80px;top:500px;font-size:38px;color:#22d3ee;opacity:0;white-space:nowrap">int(raw) → новий об'єкт</div>
  <div id="n2" class="lab" style="left:80px;top:570px;font-size:38px;color:#fbbf24;opacity:0;white-space:nowrap">початковий рядок не змінився</div>
  <div id="n3" class="mono abs" style="left:80px;top:680px;font-size:34px;color:#9fb2cf;opacity:0;white-space:pre">id(raw)     4400079248
id(number)  4395252232</div>
  <div id="nsw"></div><div id="obw"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const CC = { c: "#22d3ee", e: "#34d399", a: "#fbbf24", r: "#fb7185", g: "#9fb2cf" };
$("svg").innerHTML = `<defs>${Object.values(CC).map((c) => `<marker id="mk${c.slice(1)}" markerWidth="30" markerHeight="30" refX="26" refY="15" orient="auto" markerUnits="userSpaceOnUse"><path d="M0 2 L28 15 L0 28 z" fill="${c}"/></marker>`).join("")}</defs>`;
const ARW = (id, x1, y1, x2, y2, c) => $("svg").insertAdjacentHTML("beforeend", `<line id="${id}" x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${c}" stroke-width="6" marker-end="url(#mk${c.slice(1)})" opacity="0"/>`);
// namespace card: names = [[label, color], ...]; name boxes are shown individually
const NSC = (id, left, top, names) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:300px;height:${90 + names.length * 110}px;opacity:0"><div class="lab" style="left:28px;top:16px;font-size:34px">імена</div>${names.map(([t, c], i) => `<div id="${id}n${i}" class="mono abs" style="left:30px;top:${80 + i * 110}px;width:240px;height:80px;border:4px solid ${c};border-radius:14px;color:${c};font-size:46px;display:flex;align-items:center;justify-content:center;opacity:0">${t}</div>`).join("")}</div>`;
const NSX = (left) => left + 270, NSY = (top, i) => top + 80 + i * 110 + 40;
// object plaque: type / value / id
const OB = (id, left, top, type, val, vcol, idv, w = 420) => `<div id="${id}" class="card" style="left:${left}px;top:${top}px;width:${w}px;height:230px;border-color:#34d399;opacity:0"><div class="mono abs" style="left:24px;top:12px;font-size:30px;color:#22d3ee">${type}</div><div class="mono abs" style="left:0;width:${w}px;top:52px;text-align:center;font-size:${val.length > 7 ? 56 : 80}px;color:${vcol}">${val}</div><div class="mono abs" style="left:24px;top:172px;font-size:28px;color:#fbbf24">id ${idv}</div></div>`;

$("nsw").innerHTML = NSC("ns", 900, 200, [["raw", CC.c], ["number", CC.a]]);
$("obw").innerHTML = OB("os", 1400, 180, "str", '"41"', "#34d399", "4400079248") + OB("oi", 1400, 540, "int", "41", "#34d399", "4395252232");
ARW("ar", NSX(900), NSY(200, 0), 1394, 290, CC.c);
ARW("an", NSX(900), NSY(200, 1), 1394, 655, CC.a);
tl.set("#ed", { opacity: 1 }, 0); tl.set("#hl", { opacity: 1 }, 0);
// L1 conversion does not change the original
show("#ns", T[0] + 0.8, 0.3); pulse("#ed", T[0] + 1.6, 1.02);
// L2 raw -> "41"
show("#nsn0", T[1] + 0.2, 0.3); show("#os", T[1] + 0.6, 0.3); show("#ar", T[1] + 1.2, 0.3);
// L3 int(raw) creates a new object
show("#l2", T[2] + 0.1, 0.2); tl.set("#hl", { y: 54 }, T[2] + 0.3); show("#n1", T[2] + 0.8);
show("#oi", T[2] + 1.8, 0.3); show("#nsn1", T[2] + 2.4, 0.3); show("#an", T[2] + 3.0, 0.3);
// L4 two different objects
show("#n2", T[3] + 0.4); pulse("#os", T[3] + 0.8, 1.04); pulse("#oi", T[3] + 2.0, 1.04); show("#n3", T[3] + 3.0); pulse("#n3", T[3] + 3.6, 1.03);
hide("#ed", CL - 0.35, 0.3); hide("#os", CL - 0.35, 0.3); hide("#ar", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
