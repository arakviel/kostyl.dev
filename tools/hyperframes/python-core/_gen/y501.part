</div>

  <div id="sc" class="mono abs" style="left:1000px;top:90px;font-size:56px;color:#22d3ee;opacity:0"><span style="color:#9cdcfe">score</span> = <span style="color:#b5cea8">82</span></div>
  <div id="bA" class="br" style="top:210px;color:#9fb2cf"><span class="g">A</span><span style="font-size:36px">score &gt;= 90</span><span id="kA" class="sk">пропущено</span></div>
  <div id="bB" class="br" style="top:350px;color:#9fb2cf"><span class="g">B</span><span style="font-size:36px">score &gt;= 75</span><span id="kB" class="sk" style="color:#34d399">виконується</span></div>
  <div id="bC" class="br" style="top:490px;color:#9fb2cf"><span class="g">C</span><span style="font-size:36px">score &gt;= 60</span><span id="kC" class="sk">пропущено</span></div>
  <div id="bF" class="br" style="top:630px;color:#9fb2cf"><span class="g">F</span><span style="font-size:36px">інакше</span><span id="kF" class="sk">пропущено</span></div>
