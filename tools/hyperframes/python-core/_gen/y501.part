  <div class="vsr"></div><div class="vst">grade.py</div>
  <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">score</span> = <span style="color:#b5cea8">82</span></span></div>
  <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#c586c0">if</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">90</span>:</span></div>
  <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"A"</span></span></div>
  <div class="vsl" style="top:280px"><span class="n">4</span><span style="white-space:pre"><span style="color:#c586c0">elif</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">75</span>:</span></div>
  <div class="vsl" style="top:334px"><span class="n">5</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"B"</span></span></div>
  <div class="vsl" style="top:388px"><span class="n">6</span><span style="white-space:pre"><span style="color:#c586c0">elif</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">60</span>:</span></div>
  <div class="vsl" style="top:442px"><span class="n">7</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"C"</span></span></div>
  <div class="vsl" style="top:496px"><span class="n">8</span><span style="white-space:pre"><span style="color:#c586c0">else</span>:</span></div>
  <div class="vsl" style="top:550px"><span class="n">9</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"F"</span></span></div>
  <div class="vsl" style="top:604px"><span class="n">10</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span>(<span style="color:#9cdcfe">grade</span>)</span></div>
