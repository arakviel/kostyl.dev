<script>
/*PRE*/
/*HW*/
/*T*/
tl.set("#ed", { opacity: 1 }, 0);
// L1 so far every line ran
for (let k = 0; k < 10; k++) tl.set("#hl", { y: k * 54, opacity: 1 }, T[0] + 0.3 + k * 0.22);
tl.to("#hl", { opacity: 0, duration: 0.2 }, T[0] + 2.7);
// L2 now it chooses
show("#sc", T[1] + 0.2); ["#bA", "#bB", "#bC", "#bF"].forEach((s, i) => show(s, T[1] + 0.5 + i * 0.3, 0.3));
// L3 one branch runs, others skipped
tl.set("#hl", { y: 4 * 54, opacity: 1 }, T[2] + 0.6);
tl.to("#bB", { borderColor: "#34d399", color: "#34d399", duration: 0.3 }, T[2] + 0.6); show("#kB", T[2] + 0.8);
["#kA", "#kC", "#kF"].forEach((s, i) => show(s, T[2] + 1.4 + i * 0.4));
["#bA", "#bC", "#bF"].forEach((s) => tl.to(s, { opacity: 0.35, duration: 0.4 }, T[2] + 1.4));
show("#term", T[2] + 2.6, 0.3); show("#o1", T[2] + 3.2, 0.1); pulse("#o1", T[2] + 3.3, 1.1);
["#sc", "#ed", "#bA", "#bB", "#bC", "#bF", "#term"].forEach((x) => hide(x, CL - 0.35, 0.3));
window.__timelines["world"] = tl;
</script>
