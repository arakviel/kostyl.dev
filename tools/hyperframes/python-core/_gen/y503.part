<script>
/*PRE*/
/*HW*/
/*T*/
const showX = (i, at) => { ["A", "B", "C", "D", "E"].forEach((j) => { if (j !== i) hide("#x" + j, at - 0.05, 0.15); }); show("#x" + i, at, 0.2); };
const line = (k, at) => tl.set("#hl", { y: (k - 4) * 54, opacity: 1 }, at);
tl.set("#ed", { opacity: 1 }, 0); tl.set("#xA", { opacity: 1 }, 0);
// L1 left to right
tl.set("#hl", { y: 0, opacity: 1 }, T[0] + 0.4); pulse("#xA", T[0] + 1.5, 1.02);
// L2 0 and f(): f is not called
show("#sA", T[1] + 1.2); tl.to("#rA", { opacity: 0.3, duration: 0.4 }, T[1] + 1.2); show("#vA", T[1] + 2.2); show("#t0", T[1] + 3.0, 0.1); pulse("#t0", T[1] + 3.1, 1.1);
// L3 1 and f(): f is called
showX("B", T[2] + 0.2); line(5, T[2] + 0.2); show("#sB", T[2] + 1.0); show("#vB", T[2] + 1.8); show("#t1", T[2] + 2.2, 0.1); show("#t2", T[2] + 2.6, 0.1);
// L4 mirror rule for or
showX("C", T[3] + 0.2); line(6, T[3] + 0.2); show("#sC", T[3] + 1.0); tl.to("#rC", { opacity: 0.3, duration: 0.4 }, T[3] + 1.0); show("#vC", T[3] + 1.8); show("#t3", T[3] + 2.2, 0.1);
showX("D", T[3] + 3.0); line(7, T[3] + 3.0); show("#sD", T[3] + 3.6); show("#vD", T[3] + 4.0); show("#t4", T[3] + 4.0, 0.1); show("#t5", T[3] + 4.4, 0.1);
// L5 the operand is returned
showX("E", T[4] + 0.3); line(8, T[4] + 0.3); show("#sE", T[4] + 1.4); show("#vE", T[4] + 2.4); show("#t6", T[4] + 3.4, 0.1); pulse("#t6", T[4] + 3.5, 1.1); pulse("#vE", T[4] + 4.6, 1.1); pulse("#xE", T[4] + 5.4, 1.02);
hide("#xp", CL - 0.35, 0.3); hide("#ed", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
