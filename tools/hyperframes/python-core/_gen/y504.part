<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="cf" class="card" style="left:80px;top:130px;width:840px;height:560px;border-color:#fb7185"><div class="lab" style="left:30px;top:20px;font-size:42px;color:#fb7185">хибне → False</div><div id="f1" class="abs mono" style="left:60px;top:120px;width:340px;height:100px;border:4px solid #fb7185;border-radius:16px;color:#fb7185;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">0</div><div id="f2" class="abs mono" style="left:440px;top:120px;width:340px;height:100px;border:4px solid #fb7185;border-radius:16px;color:#fb7185;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">0.0</div><div id="f3" class="abs mono" style="left:60px;top:250px;width:340px;height:100px;border:4px solid #fb7185;border-radius:16px;color:#fb7185;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">""</div><div id="f4" class="abs mono" style="left:440px;top:250px;width:340px;height:100px;border:4px solid #fb7185;border-radius:16px;color:#fb7185;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">[]</div><div id="f5" class="abs mono" style="left:60px;top:380px;width:340px;height:100px;border:4px solid #fb7185;border-radius:16px;color:#fb7185;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">None</div></div>
  <div id="ct" class="card" style="left:1000px;top:130px;width:840px;height:560px;border-color:#34d399"><div class="lab" style="left:30px;top:20px;font-size:42px;color:#34d399">істинне → True</div><div id="t1x" class="abs mono" style="left:60px;top:120px;width:340px;height:100px;border:4px solid #34d399;border-radius:16px;color:#34d399;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">"0"</div><div id="t2x" class="abs mono" style="left:440px;top:120px;width:340px;height:100px;border:4px solid #34d399;border-radius:16px;color:#34d399;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">[0]</div><div id="t3x" class="abs mono" style="left:60px;top:250px;width:340px;height:100px;border:4px solid #34d399;border-radius:16px;color:#34d399;font-size:44px;display:flex;align-items:center;justify-content:center;opacity:0">-1</div><div id="rest" class="lab" style="left:30px;top:380px;font-size:38px;color:#9fb2cf;opacity:0">усе інше</div></div>
  <div id="term" class="vsw" style="left:80px;top:740px;width:1760px;height:230px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="o1" class="vsx" style="top:70px;font-size:40px;color:#fb7185">False False False False False</div>
    <div id="o2" class="vsx" style="top:130px;font-size:40px;color:#34d399">True True True</div>
  </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
tl.set(["#cf", "#ct"], { opacity: 1 }, 0);
pulse("#cf", 0.8, 1.02); pulse("#ct", 1.4, 1.02); pulse("#cf", 2.0, 1.02);
// L2 falsy values
show("#f1", T[1] + 0.8); show("#f2", T[1] + 1.0); show("#f3", T[1] + 1.8); show("#f4", T[1] + 2.6); show("#f5", T[1] + 3.4);
// L3 everything else is truthy
show("#rest", T[2] + 0.3); show("#t3x", T[2] + 0.8); pulse("#t3x", T[2] + 1.0, 1.08);
// L4 even "0" and [0]
show("#t1x", T[3] + 0.8); pulse("#t1x", T[3] + 1.0, 1.1); show("#t2x", T[3] + 2.4); pulse("#t2x", T[3] + 2.6, 1.1);
show("#term", T[3] + 3.0, 0.3); show("#o1", T[3] + 3.4, 0.1); show("#o2", T[3] + 3.8, 0.1);
hide("#term", CL - 0.35, 0.3); hide("#cf", CL - 0.35, 0.3); hide("#ct", CL - 0.35, 0.3);
window.__timelines["world"] = tl;
</script>
