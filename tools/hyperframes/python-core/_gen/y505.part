<style>
.dl { position: absolute; left: 860px; width: 280px; text-align: center; font-family: "JetBrains Mono", monospace; font-weight: 800; font-size: 30px; color: #9fb2cf; }
.rb { position: absolute; left: 1330px; width: 220px; height: 100px; border-radius: 16px; background: #0e1626; border: 4px solid #26365a; display: flex; align-items: center; justify-content: center; font-family: "JetBrains Mono", monospace; font-weight: 800; font-size: 52px; color: #9fb2cf; }
.yn { position: absolute; font-size: 30px; font-weight: 700; opacity: 0; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0">
    <g id="fc"><polygon points="1000,125 1190,210 1000,295 810,210" fill="#0e1626" stroke="#26365a" stroke-width="5"/><polygon points="1000,365 1190,450 1000,535 810,450" fill="#0e1626" stroke="#26365a" stroke-width="5"/><polygon points="1000,605 1190,690 1000,775 810,690" fill="#0e1626" stroke="#26365a" stroke-width="5"/>
    <line id="l1" x1="1000" y1="295" x2="1000" y2="365" stroke="#5a6c8c" stroke-width="5"/><line id="l2" x1="1000" y1="535" x2="1000" y2="605" stroke="#5a6c8c" stroke-width="5"/><line id="l3" x1="1000" y1="775" x2="1000" y2="845" stroke="#5a6c8c" stroke-width="5"/>
    <line id="y1" x1="1190" y1="210" x2="1325" y2="210" stroke="#5a6c8c" stroke-width="5"/><line id="y2" x1="1190" y1="450" x2="1325" y2="450" stroke="#5a6c8c" stroke-width="5"/><line id="y3" x1="1190" y1="690" x2="1325" y2="690" stroke="#5a6c8c" stroke-width="5"/>
    </g>
  </svg>
<div id="ed" class="vsw" style="left:60px;top:150px;width:700px;height:700px">
  <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">grade.py</div></div>
  <div class="vsr"></div><div class="vst">grade.py</div>
  <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">score</span> = <span style="color:#b5cea8">82</span></span></div>
  <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#c586c0">if</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">90</span>:</span></div>
  <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"A"</span></span></div>
  <div class="vsl" style="top:280px"><span class="n">4</span><span style="white-space:pre"><span style="color:#c586c0">elif</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">75</span>:</span></div>
  <div class="vsl" style="top:334px"><span class="n">5</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"B"</span></span></div>
  <div class="vsl" style="top:388px"><span class="n">6</span><span style="white-space:pre"><span style="color:#c586c0">elif</span> <span style="color:#9cdcfe">score</span> &gt;= <span style="color:#b5cea8">60</span>:</span></div>
  <div class="vsl" style="top:442px"><span class="n">7</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"C"</span></span></div>
  <div class="vsl" style="top:496px"><span class="n">8</span><span style="white-space:pre"><span style="color:#c586c0">else</span>:</span></div>
  <div class="vsl" style="top:550px"><span class="n">9</span><span style="white-space:pre">    <span style="color:#9cdcfe">grade</span> = <span style="color:#ce9178">"F"</span></span></div>
  <div class="vsl" style="top:604px"><span class="n">10</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span>(<span style="color:#9cdcfe">grade</span>)</span></div>
  <div id="hl" style="position:absolute;left:0;width:700px;height:54px;top:118px;background:rgba(251,191,36,0.2);opacity:0"></div>
</div>

  <div id="d1" class="dl" style="top:192px">score &gt;= 90</div><div id="d2" class="dl" style="top:432px">score &gt;= 75</div><div id="d3" class="dl" style="top:672px">score &gt;= 60</div>
  <div id="rA" class="rb" style="top:160px">A</div><div id="rB" class="rb" style="top:400px">B</div><div id="rC" class="rb" style="top:640px">C</div>
  <div id="rF" class="rb" style="left:890px;top:850px;width:220px">F</div>
  <div id="n1" class="yn" style="left:1020px;top:300px;color:#fb7185">ні</div><div id="n2" class="yn" style="left:1020px;top:540px;color:#fb7185">ні</div><div id="n3" class="yn" style="left:1020px;top:780px;color:#fb7185">ні</div>
  <div id="y1t" class="yn" style="left:1220px;top:165px;color:#9fb2cf">так</div><div id="y2t" class="yn" style="left:1220px;top:405px;color:#34d399">так</div><div id="y3t" class="yn" style="left:1220px;top:645px;color:#9fb2cf">так</div>
  <div id="sc" class="mono abs" style="left:1600px;top:420px;font-size:40px;color:#22d3ee;opacity:0;white-space:nowrap">score = 82</div>
  <div id="term" class="vsw" style="left:1330px;top:830px;width:490px;height:190px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="o1" class="vsx" style="top:80px;font-size:56px;color:#34d399;font-weight:700">B</div>
  </div>
  <div id="nt" class="lab" style="left:830px;top:100px;width:600px;font-size:36px;color:#fbbf24;opacity:0;white-space:nowrap">порядок умов має значення</div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const $ = (id) => document.getElementById(id);
const lit = (id, c, at) => { const el = document.querySelector("#svg polygon:nth-of-type(" + id + ")"); tl.to(el, { attr: { stroke: c }, duration: 0.3 }, at); };
tl.set("#ed", { opacity: 1 }, 0);
// L1 top to bottom
tl.to("#hl", { opacity: 1, duration: 0.2 }, T[0] + 0.3);
pulse("#d1", T[0] + 0.6, 1.1); pulse("#d2", T[0] + 1.0, 1.1); pulse("#d3", T[0] + 1.4, 1.1);
// L2 first condition false
tl.set("#hl", { y: 54 }, T[1] + 0.3); show("#sc", T[1] + 0.4); lit(1, "#fbbf24", T[1] + 0.6); pulse("#d1", T[1] + 0.8, 1.1);
show("#n1", T[1] + 2.2); lit(1, "#fb7185", T[1] + 2.2); tl.to("#l1", { attr: { stroke: "#fbbf24" }, duration: 0.3 }, T[1] + 3.0); lit(2, "#fbbf24", T[1] + 3.2);
// L3 second condition true -> B
tl.set("#hl", { y: 3 * 54 }, T[2] + 0.2); show("#y2t", T[2] + 0.8); tl.to("#y2", { attr: { stroke: "#34d399" }, duration: 0.3 }, T[2] + 1.0); lit(2, "#34d399", T[2] + 1.0);
tl.to("#rB", { borderColor: "#34d399", color: "#34d399", duration: 0.3 }, T[2] + 1.6); tl.set("#hl", { y: 4 * 54 }, T[2] + 1.8);
show("#term", T[2] + 3.0, 0.3); show("#o1", T[2] + 3.6, 0.1); pulse("#o1", T[2] + 3.7, 1.1); pulse("#rB", T[2] + 4.4, 1.08);
// L4 the rest is skipped
["#rA", "#rC", "#rF", "#d3"].forEach((s, i) => tl.to(s, { opacity: 0.3, duration: 0.4 }, T[3] + 0.3 + i * 0.3));
// L5 order matters
show("#nt", T[4] + 0.3); pulse("#nt", T[4] + 1.3, 1.03);
hide("#nt", CL - 0.35, 0.3); ["#ed", "#svg", "#d1", "#d2", "#d3", "#rA", "#rB", "#rC", "#rF", "#term", "#sc", "#n1", "#n2", "#n3", "#y1t", "#y2t", "#y3t"].forEach((x) => hide(x, CL - 0.35, 0.3));
window.__timelines["world"] = tl;
</script>
