    <div class="mono abs" style="left:24px;top:60px;font-size:30px;color:#d4d4d4;white-space:pre">cmd = ("move", 3)
match cmd:
    case ("stop",):
        print("стоп")
    case ("move", steps):
        print("крок", steps)
    case _:
        print("?")</div>
