<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="ed" class="vsw" style="left:60px;top:90px;width:1000px;height:800px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">match.py</div></div>
    <div class="vsr"></div><div class="vst">match.py</div>
<div class="vsl" style="top:118px;font-size:30px"><span class="n" style="font-size:28px">1</span><span style="white-space:pre"><span style="color:#569cd6">def</span> <span style="color:#dcdcaa">classify</span>(c):</span></div><div class="vsl" style="top:172px;font-size:30px"><span class="n" style="font-size:28px">2</span><span style="white-space:pre">    <span style="color:#c586c0">match</span> c:</span></div><div class="vsl" style="top:226px;font-size:30px"><span class="n" style="font-size:28px">3</span><span style="white-space:pre">        <span style="color:#c586c0">case</span> <span style="color:#b5cea8">1</span>:</span></div><div class="vsl" style="top:280px;font-size:30px"><span class="n" style="font-size:28px">4</span><span style="white-space:pre">            <span style="color:#c586c0">return</span> <span style="color:#ce9178">"один"</span></span></div><div class="vsl" style="top:334px;font-size:30px"><span class="n" style="font-size:28px">5</span><span style="white-space:pre">        <span style="color:#c586c0">case</span> <span style="color:#b5cea8">2</span> | <span style="color:#b5cea8">3</span>:</span></div><div class="vsl" style="top:388px;font-size:30px"><span class="n" style="font-size:28px">6</span><span style="white-space:pre">            <span style="color:#c586c0">return</span> <span style="color:#ce9178">"два або три"</span></span></div><div class="vsl" style="top:442px;font-size:30px"><span class="n" style="font-size:28px">7</span><span style="white-space:pre">        <span style="color:#c586c0">case</span> <span style="color:#ce9178">"go"</span>:</span></div><div class="vsl" style="top:496px;font-size:30px"><span class="n" style="font-size:28px">8</span><span style="white-space:pre">            <span style="color:#c586c0">return</span> <span style="color:#ce9178">"команда"</span></span></div><div class="vsl" style="top:550px;font-size:30px"><span class="n" style="font-size:28px">9</span><span style="white-space:pre">        <span style="color:#c586c0">case</span> <span style="color:#9cdcfe">x</span> <span style="color:#c586c0">if</span> <span style="color:#dcdcaa">isinstance</span>(<span style="color:#9cdcfe">x</span>, <span style="color:#4ec9b0">int</span>) <span style="color:#c586c0">and</span> <span style="color:#9cdcfe">x</span> &gt; <span style="color:#b5cea8">100</span>:</span></div><div class="vsl" style="top:604px;font-size:30px"><span class="n" style="font-size:28px">10</span><span style="white-space:pre">            <span style="color:#c586c0">return</span> <span style="color:#ce9178">"велике число"</span></span></div><div class="vsl" style="top:658px;font-size:30px"><span class="n" style="font-size:28px">11</span><span style="white-space:pre">        <span style="color:#c586c0">case</span> _:</span></div><div class="vsl" style="top:712px;font-size:30px"><span class="n" style="font-size:28px">12</span><span style="white-space:pre">            <span style="color:#c586c0">return</span> <span style="color:#ce9178">"інше"</span></span></div>
