<style>
.row2 { position: absolute; left: 0; width: 460px; height: 62px; display: flex; font-family: "JetBrains Mono", monospace; font-weight: 700; font-size: 38px; opacity: 0; }
.row2 span { width: 200px; text-align: center; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <svg id="svg" width="1920" height="1080" viewBox="0 0 1920 1080" style="position:absolute;left:0;top:0">
    <polygon id="dm" points="1040,150 1240,250 1040,350 840,250" fill="#0e1626" stroke="#26365a" stroke-width="5"/>
    <line x1="1040" y1="350" x2="1040" y2="470" stroke="#5a6c8c" stroke-width="5"/>
    <rect id="bd" x="840" y="470" width="400" height="120" rx="16" fill="#0e1626" stroke="#26365a" stroke-width="5"/>
    <path d="M840 530 H790 V250 H840" fill="none" stroke="#5a6c8c" stroke-width="5"/>
    <line x1="1240" y1="250" x2="1330" y2="250" stroke="#5a6c8c" stroke-width="5"/>
  </svg>
  <div id="ed" class="vsw" style="left:60px;top:100px;width:680px;height:470px">
    <div class="vsb"><span class="vsd" style="left:20px;background:#ff5f57"></span><span class="vsd" style="left:48px;background:#febc2e"></span><span class="vsd" style="left:76px;background:#28c840"></span><div class="vsT">while.py</div></div>
    <div class="vsr"></div><div class="vst">while.py</div>
    <div class="vsl" style="top:118px"><span class="n">1</span><span style="white-space:pre"><span style="color:#9cdcfe">n</span> = <span style="color:#b5cea8">3</span></span></div>
    <div class="vsl" style="top:172px"><span class="n">2</span><span style="white-space:pre"><span style="color:#9cdcfe">total</span> = <span style="color:#b5cea8">0</span></span></div>
    <div class="vsl" style="top:226px"><span class="n">3</span><span style="white-space:pre"><span style="color:#c586c0">while</span> <span style="color:#9cdcfe">n</span> &gt; <span style="color:#b5cea8">0</span>:</span></div>
    <div class="vsl" style="top:280px"><span class="n">4</span><span style="white-space:pre">    <span style="color:#9cdcfe">total</span> += <span style="color:#9cdcfe">n</span></span></div>
    <div class="vsl" style="top:334px"><span class="n">5</span><span style="white-space:pre">    <span style="color:#9cdcfe">n</span> -= <span style="color:#b5cea8">1</span></span></div>
    <div class="vsl" style="top:388px"><span class="n">6</span><span style="white-space:pre"><span style="color:#dcdcaa">print</span>(<span style="color:#9cdcfe">total</span>)</span></div>
    <div id="hl" style="position:absolute;left:0;width:680px;height:54px;top:226px;background:rgba(251,191,36,0.2);opacity:0"></div>
  </div>
  <div id="dl" class="mono abs" style="left:900px;top:222px;width:280px;text-align:center;font-size:36px;color:#9fb2cf">n &gt; 0 ?</div>
  <div id="bl" class="mono abs" style="left:840px;top:500px;width:400px;text-align:center;font-size:32px;color:#9fb2cf;white-space:pre">total += n
n -= 1</div>
  <div id="ys" class="lab" style="left:1060px;top:380px;font-size:32px;color:#34d399;opacity:0">так</div>
  <div id="ns" class="lab" style="left:1250px;top:196px;font-size:32px;color:#fb7185;opacity:0">ні</div>
  <div id="pt" class="mono abs" style="left:1340px;top:222px;font-size:34px;color:#9fb2cf;white-space:nowrap">print(total)</div>
  <div id="tb" class="card" style="left:1360px;top:430px;width:460px;height:420px">
    <div class="mono abs" style="left:0;top:14px;width:460px;display:flex;font-size:32px;color:#9fb2cf"><span style="width:200px;text-align:center">n</span><span style="width:200px;text-align:center">total</span></div>
    <div id="r0" class="row2" style="top:76px"><span>3</span><span>0</span></div>
    <div id="r1" class="row2" style="top:150px"><span style="color:#22d3ee">2</span><span style="color:#fbbf24">3</span></div>
    <div id="r2" class="row2" style="top:224px"><span style="color:#22d3ee">1</span><span style="color:#fbbf24">5</span></div>
    <div id="r3" class="row2" style="top:298px"><span style="color:#22d3ee">0</span><span style="color:#fbbf24">6</span></div>
  </div>
  <div id="term" class="vsw" style="left:60px;top:640px;width:680px;height:200px;opacity:0">
    <div class="vsb"><div class="vsT" style="text-align:left;left:24px">ТЕРМІНАЛ</div></div>
    <div id="o1" class="vsx" style="top:80px;font-size:56px;color:#34d399;font-weight:700">6</div>
  </div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const lit = (id, c, at) => tl.to("#" + id, { attr: { stroke: c }, duration: 0.3 }, at);
tl.set("#ed", { opacity: 1 }, 0); tl.set("#r0", { opacity: 1 }, 0);
// L1 check the condition first
tl.to("#hl", { opacity: 1, duration: 0.2 }, T[0] + 0.6); lit("dm", "#fbbf24", T[0] + 1.0); pulse("#dl", T[0] + 1.2, 1.1);
// L2 true -> body -> back
show("#ys", T[1] + 0.6); lit("bd", "#34d399", T[1] + 1.2); tl.set("#hl", { y: 54 }, T[1] + 1.2); pulse("#bl", T[1] + 1.6, 1.08); pulse("#dl", T[1] + 2.6, 1.1);
// L3 first two passes
show("#r1", T[2] + 0.8); pulse("#r1", T[2] + 1.0, 1.08); pulse("#bl", T[2] + 1.5, 1.08);
show("#r2", T[2] + 3.0); pulse("#r2", T[2] + 3.2, 1.08); pulse("#dl", T[2] + 3.9, 1.1);
// L4 n = 0: condition false, exit
show("#r3", T[3] + 0.8); pulse("#r3", T[3] + 1.0, 1.08);
lit("bd", "#26365a", T[3] + 1.6); show("#ns", T[3] + 2.6); lit("dm", "#fb7185", T[3] + 2.6); pulse("#dl", T[3] + 2.8, 1.1);
tl.set("#hl", { y: 162 }, T[3] + 3.4); pulse("#pt", T[3] + 3.8, 1.1);
// L5 total = 6
show("#term", T[4] + 0.3, 0.3); show("#o1", T[4] + 0.8, 0.1); pulse("#o1", T[4] + 0.9, 1.15); pulse("#r3", T[4] + 1.2, 1.08);
["#svg", "#dl", "#bl", "#ys", "#ns", "#pt", "#tb", "#ed", "#term"].forEach((x) => hide(x, CL - 0.35, 0.3));
window.__timelines["world"] = tl;
</script>
