<style>
.cpt { position: absolute; left: 80px; width: 1760px; top: 975px; text-align: center; font-size: 40px; font-weight: 700; color: #fbbf24; opacity: 0; }
.bk { position: absolute; top: 250px; width: 420px; height: 400px; border-radius: 20px; background: #0e1626; border: 4px solid #26365a; opacity: 0.35; }
.bt { position: absolute; left: 24px; top: 16px; font-size: 34px; font-weight: 700; }
.bc { position: absolute; left: 0; width: 420px; text-align: center; font-family: "JetBrains Mono", monospace; font-weight: 700; white-space: nowrap; }
</style>
<div id="root" data-composition-id="world" data-width="1920" data-height="1080">
  <div id="k1" class="bk" style="left:60px;border-color:#22d3ee"><div class="bt" style="color:#22d3ee">while</div><div class="bc" style="top:100px;font-size:30px;color:#d4d4d4">n &gt; 0</div><div class="bc" style="top:180px;font-size:58px;color:#22d3ee">total = 6</div><div class="bc" style="top:290px;font-size:30px;color:#9fb2cf;font-family:Inter,sans-serif">поки умова істинна</div></div><div id="k2" class="bk" style="left:520px;border-color:#34d399"><div class="bt" style="color:#34d399">for</div><div class="bc" style="top:100px;font-size:30px;color:#d4d4d4">ch in &quot;кіт&quot;</div><div class="bc" style="top:180px;font-size:58px;color:#34d399">к і т</div><div class="bc" style="top:290px;font-size:30px;color:#9fb2cf;font-family:Inter,sans-serif">ітератор бере по одному</div></div><div id="k3" class="bk" style="left:980px;border-color:#fbbf24"><div class="bt" style="color:#fbbf24">range</div><div class="bc" style="top:100px;font-size:30px;color:#d4d4d4">range(10**12)</div><div class="bc" style="top:180px;font-size:58px;color:#fbbf24">48 байтів</div><div class="bc" style="top:290px;font-size:30px;color:#9fb2cf;font-family:Inter,sans-serif">лише обчислює числа</div></div><div id="k4" class="bk" style="left:1440px;border-color:#a78bfa"><div class="bt" style="color:#a78bfa">break / continue / else</div><div class="bc" style="top:100px;font-size:30px;color:#d4d4d4">17 → дільника немає</div><div class="bc" style="top:180px;font-size:58px;color:#a78bfa">просте</div><div class="bc" style="top:290px;font-size:30px;color:#9fb2cf;font-family:Inter,sans-serif">керують ходом циклу</div></div>
  <div id="caps"></div>
</div>
<script>
/*PRE*/
/*HW*/
/*T*/
const CAPS = ["Підсумок уроку", "while повторює, поки умова істинна", "for перебирає елементи через ітератор", "range лише обчислює числа", "break, continue і else керують ходом циклу"];
const $ = (id) => document.getElementById(id);
CAPS.forEach((t, i) => { $("caps").insertAdjacentHTML("beforeend", `<div id="cp${i}" class="cpt">${t}</div>`); show("#cp" + i, T[i] + 0.2, 0.3); hide("#cp" + i, (i < CAPS.length - 1 ? T[i + 1] - 0.15 : CL - 0.35), 0.25); });
tl.set(["#k1", "#k2", "#k3", "#k4"], { opacity: 0.35 }, 0);
pulse("#k1", 0.6, 1.02);
[1, 2, 3, 4].forEach((k, i) => { tl.to("#k" + k, { opacity: 1, duration: 0.4 }, T[i + 1] + 0.3); pulse("#k" + k, T[i + 1] + 0.8, 1.05); pulse("#k" + k, T[i + 1] + 2.0, 1.03); pulse("#k" + k, T[i + 1] + 3.0, 1.03); });
window.__timelines["world"] = tl;
</script>
